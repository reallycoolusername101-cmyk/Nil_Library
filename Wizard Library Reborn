local tipOwner, tipConn

local function hideTip(owner)
	if owner == nil or owner == tipOwner then
		tip.Visible = false
		tipOwner = nil
		if tipConn then
			tipConn:Disconnect()
			tipConn = nil
		end
	end
end

local function showTip(owner, cfg)
	local header, text = cfg.Header, cfg.Text
	local hb = header and TextService:GetTextSize(tostring(header), 16, Enum.Font.SourceSansBold, Vector2.new(TIP_MAX, 10000)) or Vector2.zero
	local bb = text and TextService:GetTextSize(tostring(text), 14, Enum.Font.SourceSans, Vector2.new(TIP_MAX, 10000)) or Vector2.zero
	local w = math.ceil(math.max(hb.X, bb.X)) + 2
	local y = 6

	tipHeader.Visible = header ~= nil
	tipHeader.Text = header or ""
	tipHeader.Position = UDim2.fromOffset(8, y)
	tipHeader.Size = UDim2.fromOffset(w, hb.Y)
	if header then
		y += hb.Y + (text and 2 or 0)
	end

	tipBody.Visible = text ~= nil
	tipBody.Text = text or ""
	tipBody.Position = UDim2.fromOffset(8, y)
	tipBody.Size = UDim2.fromOffset(w, bb.Y)
	if text then
		y += bb.Y
	end

	tip.Size = UDim2.fromOffset(w + 16, y + 6)
	tipOwner = owner
	tip.Visible = true

	if tipConn then
		tipConn:Disconnect()
	end
	tipConn = RunService.RenderStepped:Connect(function()
		local m = UIS:GetMouseLocation()
		local size, screen = tip.AbsoluteSize, container.AbsoluteSize
		local x, py = m.X + 14, m.Y + 18
		if x + size.X > screen.X then
			x = m.X - size.X - 10
		end
		if py + size.Y > screen.Y then
			py = m.Y - size.Y - 10
		end
		local uiFactor = (uiScale and type(uiScale.Scale) == "number") and math.max(uiScale.Scale, 0.01) or 1
		tip.Position = UDim2.fromOffset(
			math.max(0, x) / uiFactor,
			math.max(0, py) / uiFactor
		)
	end)
end

local function bindHover(root, cfg)
	local inside, armed, token = 0, false, 0
	local owner = {}

	local function enter()
		inside += 1
		if armed then
			return
		end
		armed = true
		token += 1
		local mine = token
		local delay = cfg.Delay ~= nil and cfg.Delay or Library.Tooltips.Delay
		task.delay(delay, function()
			if token ~= mine or not armed then
				return
			end
			if not (Library.Tooltips.Enabled and cfg.Enabled ~= false) then
				return
			end
			if not (cfg.Text or cfg.Header) then
				return
			end
			showTip(owner, cfg)
			local dur = cfg.Duration ~= nil and cfg.Duration or Library.Tooltips.Duration
			if dur and dur > 0 then
				task.delay(dur, function()
					if token == mine then
						hideTip(owner)
					end
				end)
			end
		end)
	end

	local function leave()
		inside = math.max(0, inside - 1)
		task.delay(0.06, function()
			if inside == 0 and armed then
				armed = false
				token += 1
				hideTip(owner)
			end
		end)
	end

	local function hook(inst)
		if inst:IsA("GuiObject") then
			inst.MouseEnter:Connect(enter)
			inst.MouseLeave:Connect(leave)
		end
	end

	hook(root)
	for _, d in ipairs(root:GetDescendants()) do
		hook(d)
	end
end

-- adds .Frame and :SetTooltip() to an element and wires up hovering
local function finalize(row, obj)
	local cfg = { Enabled = true }
	local userSet = false
	obj.Frame = row

	-- built-in description; never overrides a tooltip the script set itself
	function obj:__SetDefaultTip(c)
		if userSet then return end
		cfg.Header, cfg.Text, cfg.Delay = c.Header, c.Text, c.Delay or 0.5
		cfg.Enabled = true
	end

	function obj:SetTooltip(c)
		userSet = true
		if c == false then
			cfg.Enabled = false
		elseif c == nil then
			cfg.Header, cfg.Text = nil, nil
		else
			for k, v in pairs(c) do
				cfg[k] = v
			end
			if c.Enabled == nil then
				cfg.Enabled = true
			end
		end
		return obj
	end

	bindHover(row, cfg)
	return obj
end

