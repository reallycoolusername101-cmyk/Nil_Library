local function clampCategoricalRange(startIndex, endIndex, count)
	if count <= 0 then
		return 1, 1
	end
	local span = math.clamp(math.floor((endIndex - startIndex + 1) + 0.5), 1, count)
	startIndex = math.floor(startIndex + 0.5)
	startIndex = math.clamp(startIndex, 1, math.max(1, count - span + 1))
	return startIndex, startIndex + span - 1
end

local function zoomCategoricalRange(startIndex, endIndex, count, mouseAlpha, factor)
	if count <= 1 then
		return 1, 1
	end

	startIndex, endIndex = clampCategoricalRange(startIndex, endIndex, count)

	local span = endIndex - startIndex + 1
	local alpha = clamp01(mouseAlpha)
	local anchor = startIndex + alpha * (span - 1)
	local newSpan = math.clamp(math.floor(span * factor + 0.5), 1, count)
	local newStart = math.floor(anchor - alpha * (newSpan - 1) + 0.5)

	newStart = math.clamp(newStart, 1, math.max(1, count - newSpan + 1))
	return newStart, newStart + newSpan - 1
end

local function drawAnimatedSegment(parent, x1, y1, x2, y2, color, duration)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 0.01 then
		return
	end

	local gradient = typeof(color) == "ColorSequence"
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = gradient and Color3.new(1, 1, 1) or color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(0, 2),
		Rotation = math.deg(math.atan2(dy, dx)),
	}, parent)
	if gradient then create("UIGradient", { Color = color, Rotation = 0 }, frame) end

	local info = TweenInfo.new(
		duration or 0.18,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)

	pcall(function()
		TweenService:Create(frame, info, {
			Size = UDim2.fromOffset(len + 1, 2),
		}):Play()
	end)
end

