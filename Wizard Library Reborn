Library.Notification = {Enabled=true, DefaultDuration=3.5}

local LEVEL_COLORS = {
	Info = Color3.fromRGB(87,170,255),
	Success = Color3.fromRGB(120,220,120),
	Warning = Color3.fromRGB(255,200,80),
	Error = Color3.fromRGB(240,80,80),
	Debug = Color3.fromRGB(178,178,178),
}

Library.Logger = {
	Entries = {},
	MaxEntries = 200,
	Subscribers = {},
}

function Library:SubscribeLogs(callback)
	if type(callback) ~= 'function' then return function() end end
	self.Logger.Subscribers[#self.Logger.Subscribers+1] = callback
	local active = true
	return function()
		if not active then return end
		active = false
		local index = table.find(self.Logger.Subscribers, callback)
		if index then table.remove(self.Logger.Subscribers,index) end
	end
end

function Library:Log(level, message)
	level = tostring(level or 'Info')
	local entry = {
		Time = os.date('%H:%M:%S'),
		Timestamp = os.time(),
		Level = level,
		Message = tostring(message or ''),
		Color = LEVEL_COLORS[level] or COLORS.SubText,
	}
	self.Logger.Entries[#self.Logger.Entries+1] = entry
	while #self.Logger.Entries > self.Logger.MaxEntries do
		table.remove(self.Logger.Entries,1)
	end
	for _, callback in ipairs(table.clone(self.Logger.Subscribers)) do
		pcall(callback, entry)
	end
	return entry
end

function Library:Info(message) return self:Log('Info',message) end
function Library:Success(message) return self:Log('Success',message) end
function Library:Warning(message) return self:Log('Warning',message) end
function Library:Error(message) return self:Log('Error',message) end
function Library:Debug(message) return self:Log('Debug',message) end
function Library:ClearLogs()
	self.Logger.Entries = {}
	for _, callback in ipairs(table.clone(self.Logger.Subscribers)) do
		pcall(callback, nil, true)
	end
	return self
end
function Library:SetLogLimit(limit)
	if type(limit) == 'number' then
		self.Logger.MaxEntries = math.clamp(math.floor(limit),10,2000)
	end
	return self
end

function Library:Notify(a,b,c,d)
	local config
	if type(a) == 'table' then
		config = table.clone(a)
	else
		config = {Title=a, Text=b, Duration=c, Type=d}
	end
	if not self.Notification.Enabled then return self end

	config.Title = tostring(config.Title or config.Type or 'Notification')
	config.Text = tostring(config.Text or '')
	local defaultDuration=tonumber(self.Notification.DefaultDuration) or 3.5
	config.Duration = math.max(0.4, tonumber(config.Duration) or defaultDuration)
	config.Type = tostring(config.Type or 'Info')
	config.Color = config.Color or LEVEL_COLORS[config.Type] or COLORS.Accent

	if config.Log ~= false then
		self:Log(config.Type, config.Title .. (config.Text ~= '' and (': '..config.Text) or ''))
	end

	local GLYPHS = {Success = '\u{2713}', Warning = '!', Error = '×', Info = 'i', Debug = '\u{2022}'}
	local glyph = config.Glyph or GLYPHS[config.Type] or 'i'

	local CARD_W, CARD_H = 256, 52

	-- Everything for one notification lives inside a single wrapper frame so
	-- the vertical UIListLayout on notificationHolder treats it as ONE row;
	-- previously the shadow and card were separate siblings of the holder,
	-- so the list layout stacked them as two separate rows (visible as a
	-- stray dark box sitting above/below the actual card).
	local entry = create('Frame', {
		Name = 'NotifEntry',
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(CARD_W + 6, CARD_H + 6),
