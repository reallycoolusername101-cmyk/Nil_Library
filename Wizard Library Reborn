		pop.Position = UDim2.fromOffset(x, y)
		pop.BackgroundTransparency = 0.2
		safeGuiTween(pop, ti(0.25, Enum.EasingStyle.Quart), { Size = UDim2.fromOffset(B * 5, B * 5), BackgroundTransparency = 1 })
