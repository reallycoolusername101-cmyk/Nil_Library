---------------------------------------------------------------------------
-- graph helpers
---------------------------------------------------------------------------
local function niceStep(range, target)
	local raw = range / target
	if not (raw > 0) or raw ~= raw or raw == math.huge then
		return 1
	end
	local mag = 10 ^ math.floor(math.log10(raw))
	local norm = raw / mag
	local step = (norm < 1.5 and 1) or (norm < 3.5 and 2) or (norm < 7.5 and 5) or 10
	return step * mag
end

local function normalizePoint(p)
	if typeof(p) == "Vector2" then
		return { p.X, p.Y }
	end
	if type(p) == "table" then
		local x = p[1] or p.x or p.X
		local y = p[2] or p.y or p.Y
		if type(x) == "number" and type(y) == "number" then
			return { x, y }
		end
	end
	return nil
end

local function normalizePoints(points)
	local out = {}
	for _, p in ipairs(points or {}) do
		local n = normalizePoint(p)
		if n then
			out[#out + 1] = n
		end
	end
	return out
end

local function segment(parent, x1, y1, x2, y2, color, thick)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 0.01 then return end
	local gradient = typeof(color) == "ColorSequence"
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = gradient and Color3.new(1, 1, 1) or color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(len + 1, thick),
		Rotation = math.deg(math.atan2(dy, dx)),
	}, parent)
	if gradient then create("UIGradient", { Color = color, Rotation = 0 }, frame) end
	return frame
end

