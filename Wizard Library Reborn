local windowCount = 0

-- While a slider / picker is being dragged, window scrolling is paused so a
-- touch drag on a control never scrolls the window underneath it.
local scrollLocks = 0
local scrollRefreshers = {}
local function holdScroll(on)
	scrollLocks = math.max(0, scrollLocks + (on and 1 or -1))
	for _, f in ipairs(scrollRefreshers) do
		f()
	end
end

