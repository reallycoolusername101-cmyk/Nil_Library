		-- Dropdown -------------------------------------------------------
		-- Pop-out is the default: the list floats on a shared top layer directly under the
		-- header (never clipped, never covered by a window). It opens when you hover the header
		-- (or click it) and is removed as soon as the pointer leaves the header and the list.
		-- Touch screens tap to open / tap outside to close. PopOut = false keeps the inline list.
		function Section:CreateDropdown(name, list, default, callback, options)
			callback = callback or function() end
			list = list or {}
			options = options or {}

			local multi = options.Multi == true or type(default) == "table"
			local popOut = options.PopOut ~= false
			local touchOnly = UIS.TouchEnabled and not UIS.MouseEnabled
			local ROWH = 25
			local visibleRows = math.max(1, math.min(#list, 6))
			local openHeight = ROW + visibleRows * ROWH + 4
			local row = newRow(name .. "Dropdown")

			local function containsValue(tbl, value)
				for _, v in ipairs(tbl) do
					if v == value then return true end
				end
				return false
			end

			local current = multi and {} or list[default or 1]
			if multi and type(default) == "table" then
				for _, selected in ipairs(default) do
					if type(selected) == "number" and list[selected] ~= nil then
						current[#current + 1] = list[selected]
					elseif containsValue(list, selected) then
						current[#current + 1] = selected
					end
				end
			end

			local function titleText()
				if not multi then
					return current ~= nil and tostring(current) or name
				end
				if #current == 0 then
					return name
				elseif #current == 1 then
					return tostring(current[1])
				end
				return tostring(#current) .. " selected"
			end

			local head = newButton(row, titleText(), UDim2.new(0.053, 0, 0, 3), UDim2.new(0, 153, 0, 24))
			head.Name = "DropdownTitle"
			local pad = head:FindFirstChildOfClass("UIPadding")
			if pad then pad.PaddingRight = UDim.new(0, 24) end
			local arrow = create("TextLabel", {
				Name = "Arrow",
				BackgroundTransparency = 1,
				Position = UDim2.new(1, -24, 0, 0),
				Size = UDim2.new(0, 24, 1, 0),
				Font = Enum.Font.SourceSansBold,
				Text = ">",
				TextColor3 = COLORS.Text,
				TextSize = 15,
			}, head)

			-- the list: a ScrollingFrame either on the shared pop-out layer or inside the row
			local popup, popScale, scroller
			if popOut then
				local layer = gui:FindFirstChild("__WizardPopOuts")
				if not layer then
					layer = create("Frame", {
						Name = "__WizardPopOuts",
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Size = UDim2.fromScale(1, 1),
						ZIndex = 500,
					}, gui)
					local layerScale = create("UIScale", { Scale = uiScale.Scale }, layer)
					uiScale:GetPropertyChangedSignal("Scale"):Connect(function()
						layerScale.Scale = uiScale.Scale
					end)
				end
				popup = create("Frame", {
					Name = "PopOut",
					Active = true,
					Visible = false,
					BackgroundColor3 = COLORS.Window,
					BorderSizePixel = 0,
					Size = UDim2.fromOffset(160, visibleRows * ROWH + 8),
					ZIndex = 1,
					ClipsDescendants = true,
				}, layer)
				corner(popup, 6)
				popScale = create("UIScale", { Scale = 1 }, popup)
			end
			scroller = create("ScrollingFrame", {
				Name = "DropdownList",
				Active = true,
				BackgroundColor3 = COLORS.Widget,
				BorderSizePixel = 0,
				Position = popOut and UDim2.fromOffset(4, 4) or UDim2.new(0.053, 0, 0, ROW + 1),
				Size = popOut and UDim2.new(1, -8, 0, visibleRows * ROWH) or UDim2.new(0, 153, 0, visibleRows * ROWH),
				CanvasSize = UDim2.new(0, 0, 0, #list * ROWH),
				ScrollBarThickness = 3,
				ClipsDescendants = true,
				ZIndex = 2,
			}, popOut and popup or row)
			corner(scroller, 4)
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroller)

			local open = false
			local optionButtons = {}
			local stepConn, outsideConn

			local function over(g, m, padPx)
				local a, z = g.AbsolutePosition, g.AbsoluteSize
				return m.X >= a.X - padPx and m.X <= a.X + z.X + padPx and m.Y >= a.Y - padPx and m.Y <= a.Y + z.Y + padPx
			end

			-- Beside the window, on whichever side (left / right) has more free screen space.
			-- Vertically it lines up with the header and is kept fully on screen.
			local function place()
				local k = math.max(uiScale.Scale, 0.01)
				local hp, hs = head.AbsolutePosition / k, head.AbsoluteSize / k
				local wp, ws = window.AbsolutePosition / k, window.AbsoluteSize / k
				local scr = screenUnits()
				local w = math.max(hs.X, 150)
				local h = visibleRows * ROWH + 8
				local gap = 6
				local spaceRight = scr.X - (wp.X + ws.X)
				local spaceLeft = wp.X
				local x
				if spaceRight >= spaceLeft then
					x = wp.X + ws.X + gap
				else
					x = wp.X - w - gap
				end
				x = math.clamp(x, 0, math.max(0, scr.X - w))
				local y = math.clamp(hp.Y - 4, 0, math.max(0, scr.Y - h))
				popup.Size = UDim2.fromOffset(w, h)
				popup.Position = UDim2.fromOffset(x, y)
			end

			local choose
			local setOpen
			local function closeSelf() setOpen(false) end
			setOpen = function(state)
				state = state == true
				if open == state then return end
				open = state
				arrow.Text = open and "v" or ">"
				head.TextColor3 = open and COLORS.SubText or COLORS.Text
				if not popOut then
					tween(row, { Size = UDim2.new(0, WIDTH, 0, open and openHeight or ROW) })
					return
				end
				if stepConn then stepConn:Disconnect() stepConn = nil end
				if outsideConn then outsideConn:Disconnect() outsideConn = nil end
				if not open then
					popup.Visible = false
					if Library.__activePop == closeSelf then Library.__activePop = nil end
					return
				end
				-- only one pop-out at a time
				local other = Library.__activePop
				if other and other ~= closeSelf then pcall(other) end
				Library.__activePop = closeSelf
				place()
				popScale.Scale = 0.95
				popup.Visible = true
				pcall(function()
					TweenService:Create(popScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				end)

				-- follow the window while it is dragged / scrolled. The list is NEVER closed from here
				-- (no hover-out timer, no scroll-out): it is only hidden while its header is out of view.
				local l1, l2, l3, l4, l5, l6, l7, l8
				stepConn = RunService.RenderStepped:Connect(function()
					if not gui.Enabled or not window.Visible then
						setOpen(false)
						return
					end
					local hp, hs = head.AbsolutePosition, head.AbsoluteSize
					local wp, ws = window.AbsolutePosition, window.AbsoluteSize
					local sx, sy = gui.AbsoluteSize.X, gui.AbsoluteSize.Y
					if hp.X ~= l1 or hp.Y ~= l2 or wp.X ~= l3 or wp.Y ~= l4 or ws.X ~= l5 or ws.Y ~= l6 or sx ~= l7 or sy ~= l8 then
						l1, l2, l3, l4, l5, l6, l7, l8 = hp.X, hp.Y, wp.X, wp.Y, ws.X, ws.Y, sx, sy
						place()
						local cy = hp.Y + hs.Y / 2
						popup.Visible = cy >= wp.Y and cy <= wp.Y + ws.Y
					end
				end)
				-- Closes ONLY when you press outside the whole UI (any window, panel or this list).
				-- Presses on library controls are "processed" by the game; blank window areas are
				-- covered by the rectangle checks.
				outsideConn = UIS.InputBegan:Connect(function(input, processed)
					if not isPress(input) or processed then return end
					local p = pointerPos(input)
					if over(popup, p, 3) or over(head, p, 3) then return end
					for _, w in ipairs(allWindows) do
						if w.Frame.Visible and over(w.Frame, p, 3) then return end
					end
					setOpen(false)
				end)
			end
			window:GetPropertyChangedSignal("Visible"):Connect(function()
				if open and not window.Visible then setOpen(false) end
			end)

			local function emit()
				if multi then
					callback(table.clone(current))
				else
					callback(current)
				end
			end

			local function refreshButtons()
				head.Text = titleText()
				for value, button in pairs(optionButtons) do
					local selected
					if multi then selected = containsValue(current, value) else selected = (current == value) end
					local check = button:FindFirstChild("Check")
					if check then
						check.Text = selected and "\u{2713}" or ""
						check.TextColor3 = selected and COLORS.Accent or COLORS.SubText
					end
					button.TextColor3 = selected and COLORS.Accent or COLORS.Text
				end
			end

			-- picking an option never closes the list by itself (only an outside click does);
			-- pass { CloseOnSelect = true } to opt back in.
			choose = function(option, fire)
				if not multi then
					current = option
				else
					local index = table.find(current, option)
					if index then
						table.remove(current, index)
					elseif options.MaxSelections == nil or #current < math.max(1, math.floor(options.MaxSelections)) then
						current[#current + 1] = option
					end
				end
				if options.CloseOnSelect then setOpen(false) end
				refreshButtons()
				if fire then emit() end
			end

			for index, option in ipairs(list) do
				local optBtn = create("TextButton", {
					Name = tostring(option) .. "Button",
					AutoButtonColor = false,
					BackgroundColor3 = COLORS.Hover,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, -3, 0, ROWH),
					Font = Enum.Font.SourceSansBold,
					Text = tostring(option),
					TextColor3 = COLORS.Text,
					TextSize = 14,
					LayoutOrder = index,
					ZIndex = 3,
				}, scroller)
				optBtn.TextTruncate = Enum.TextTruncate.AtEnd
				create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, multi and 24 or 6) }, optBtn)
				if multi then
					create("TextLabel", {
						Name = "Check",
						BackgroundTransparency = 1,
						Position = UDim2.new(1, -23, 0, 0),
						Size = UDim2.fromOffset(20, ROWH),
						Font = Enum.Font.SourceSansBold,
						Text = "",
						TextColor3 = COLORS.SubText,
						TextSize = 15,
						ZIndex = 4,
					}, optBtn)
				end
				optionButtons[option] = optBtn
				optBtn.MouseEnter:Connect(function() tween(optBtn, { BackgroundTransparency = 0.5 }) end)
				optBtn.MouseLeave:Connect(function() tween(optBtn, { BackgroundTransparency = 1 }) end)
				optBtn.Activated:Connect(function() choose(option, true) end) -- mouse click or touch tap
			end
			refreshButtons()

			-- click the header to open. Clicking it again leaves it open; only a click outside closes it.
			head.MouseButton1Click:Connect(function()
				if popOut then
					setOpen(true)
				else
					setOpen(not open)
				end
			end)

			local obj = {}
			function obj:Set(option)
				if multi then
					current = {}
					if type(option) == "table" then
						for _, v in ipairs(option) do
							if table.find(list, v) then current[#current + 1] = v end
						end
					elseif table.find(list, option) then
						current[1] = option
					end
					refreshButtons()
					emit()
				elseif table.find(list, option) then
					current = option
					refreshButtons()
					emit()
				end
				return obj
			end
			function obj:Get()
				return multi and table.clone(current) or current
			end
			function obj:IsMulti()
				return multi
			end
			function obj:Open() setOpen(true) end
			function obj:Close() setOpen(false) end
			return finalize(row, obj)
		end

		-- Multi-state switch ------------------------------------------------
		function Section:CreateSwitch(name, states, defaultIndex, callback)
			states = states or {"Off", "On"}
			callback = callback or function() end
			local normalized = {}
			for i, state in ipairs(states) do
				if type(state) == "table" then
					normalized[i] = {Name=tostring(state.Name or state.Label or i), Color=state.Color, Description=state.Description or state.Desc}
				else
					normalized[i] = {Name=tostring(state)}
				end
			end
			if #normalized == 0 then normalized={{Name="Off"},{Name="On"}} end

			local index = 1
			if type(defaultIndex) == "number" then
				index = math.clamp(math.floor(defaultIndex),1,#normalized)
			elseif defaultIndex ~= nil then
				for i, state in ipairs(normalized) do
					if state.Name == tostring(defaultIndex) then index=i break end
				end
			end

			local row = newRow(name .. "Switch")
			label(row,name,UDim2.new(0.053,0,0,0),UDim2.new(0,92,0,ROW)).Name="SwitchTitle"
			local button = newButton(row,normalized[index].Name,UDim2.fromOffset(WIDTH-72,3),UDim2.fromOffset(64,24))
			button.Name="SwitchButton"

			local tipUpdate
			local function render()
				local state = normalized[index]
				button.Text = state.Name
				tween(button,{BackgroundColor3=state.Color or COLORS.Widget})
				if tipUpdate then tipUpdate() end
			end
			render()
			button.MouseButton1Click:Connect(function()
				index = index % #normalized + 1
				render()
				callback(normalized[index].Name,index)
			end)

			local obj={}
			function obj:Set(value, fire)
				if type(value)=="number" then
					index=math.clamp(math.floor(value),1,#normalized)
				else
					for i,state in ipairs(normalized) do
						if state.Name==tostring(value) then index=i break end
					end
				end
				render()
				if fire ~= false then callback(normalized[index].Name,index) end
				return obj
			end
			function obj:Get() return normalized[index].Name end
			function obj:GetIndex() return index end
			function obj:GetStates() return table.clone(normalized) end
			finalize(row,obj)
			-- hover the row or its label: shows what the current state does and what a click leads to
			tipUpdate = function()
				local cur, nxt = normalized[index], normalized[index % #normalized + 1]
				local lines = {}
				if cur.Description then lines[#lines+1] = cur.Description end
				lines[#lines+1] = "Click to switch to: " .. nxt.Name .. (nxt.Description and (" - " .. nxt.Description) or "")
				local names = {}
				for _, st in ipairs(normalized) do names[#names+1] = (st.Name == cur.Name) and ("[" .. st.Name .. "]") or st.Name end
				lines[#lines+1] = table.concat(names, "  >  ")
				obj:__SetDefaultTip({Header = name .. ": " .. cur.Name, Text = table.concat(lines, "\n"), Delay = 0.3})
			end
			tipUpdate()
			return obj
		end

		-- Tiny in-row sparkline -------------------------------------------
		-- Draws itself in on creation, eases between old and new data when it
		-- changes, and keeps a softly pulsing marker on the latest point.
		function Section:CreateSparkline(name, values, options)
			options = options or {}
			local row = newRow(name .. "Sparkline")
			label(row, name, UDim2.fromOffset(9, 0), UDim2.fromOffset(48, ROW), Enum.Font.SourceSansSemibold, 13, Enum.TextXAlignment.Left)
			local PLOT_W, PLOT_H = 78, 18
			local plot = create("Frame", {
				BackgroundColor3 = COLORS.Track,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(57, 6),
				Size = UDim2.fromOffset(PLOT_W, PLOT_H),
				ClipsDescendants = true,
			}, row)
			corner(plot, 4)
			-- faint midline so an empty / flat graph still reads as a graph
			create("Frame", {
				BackgroundColor3 = COLORS.Knob,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, PLOT_H / 2),
				Size = UDim2.fromOffset(PLOT_W, 1),
			}, plot)
			local clip = create("Frame", {
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Size = UDim2.fromOffset(0, PLOT_H),
			}, plot)
			local valueLabel = label(row, "", UDim2.fromOffset(138, 0), UDim2.fromOffset(27, ROW), Enum.Font.SourceSansBold, 12, Enum.TextXAlignment.Right)
			valueLabel.TextColor3 = COLORS.SubText

			local data = {}
			local shown = {}
			local fromVals = {}
			local color = options.Color or COLORS.Accent
			local loFixed, hiFixed = options.YMin, options.YMax
			local segs = {}
			local animConn
			local animT, ANIM_TIME = 1, 0.45

			local dot = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(5, 5),
				Visible = false,
				ZIndex = 3,
				NoTheme = true,
			}, clip)
			corner(dot, 3)
			local pulse = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(5, 5),
				NoTheme = true,
			}, dot)
			corner(pulse, 8)
			pcall(function()
				TweenService:Create(pulse, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, -1), {
					Size = UDim2.fromOffset(15, 15),
					BackgroundTransparency = 1,
				}):Play()
			end)

			local function cleanData(list)
				local out = {}
				for _, v in ipairs(list or {}) do
					if type(v) == "number" and v == v and math.abs(v) < 1e12 then
						out[#out + 1] = v
					end
				end
				return out
			end

			local function draw()
				local n = #shown
				valueLabel.Text = n > 0 and fmt(shown[n]) or "--"
				for i = n, #segs do
					if segs[i] then segs[i].Visible = false end
				end
				dot.Visible = n > 0
				if n < 1 then return end
				local lo, hi = loFixed, hiFixed
				if type(lo) ~= "number" or type(hi) ~= "number" then
					lo, hi = math.huge, -math.huge
					for _, v in ipairs(data) do lo = math.min(lo, v); hi = math.max(hi, v) end
					for _, v in ipairs(shown) do lo = math.min(lo, v); hi = math.max(hi, v) end
				end
				if hi - lo < 1e-9 then hi = lo + 1 end
				local function px(i) return n == 1 and PLOT_W - 3 or 2 + (i - 1) / (n - 1) * (PLOT_W - 5) end
				local function py(v) return 2 + (1 - math.clamp((v - lo) / (hi - lo), 0, 1)) * (PLOT_H - 4) end
				for i = 1, n - 1 do
					local x1, y1, x2, y2 = px(i), py(shown[i]), px(i + 1), py(shown[i + 1])
					local len = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
					local f = segs[i]
					if not f then
						f = create("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5),
							BackgroundColor3 = color,
							BorderSizePixel = 0,
							NoTheme = true,
						}, clip)
						segs[i] = f
					end
					f.BackgroundColor3 = color
					f.Visible = true
					f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
					f.Size = UDim2.fromOffset(len + 1, 1.8)
					f.Rotation = math.deg(math.atan2(y2 - y1, x2 - x1))
				end
				dot.BackgroundColor3 = color
				pulse.BackgroundColor3 = color
				dot.Position = UDim2.fromOffset(px(n), py(shown[n]))
			end

			local function stopAnim()
				if animConn then animConn:Disconnect() animConn = nil end
			end

			local function setData(list, instant)
				fromVals = table.clone(shown)
				data = cleanData(list)
				if instant or #fromVals == 0 then
					shown = table.clone(data)
					stopAnim()
					draw()
					return
				end
				-- new points grow out of the previous last value
				for i = #fromVals + 1, #data do
					fromVals[i] = fromVals[#fromVals] or data[i]
				end
				animT = 0
				stopAnim()
				animConn = RunService.RenderStepped:Connect(function(dt)
					if not row.Parent then stopAnim() return end
					animT = math.min(1, animT + dt / ANIM_TIME)
					local e = 1 - (1 - animT) ^ 3
					shown = {}
					for i = 1, #data do
						local a = fromVals[i] or data[i]
						shown[i] = a + (data[i] - a) * e
					end
					draw()
					if animT >= 1 then stopAnim() end
				end)
			end

			setData(values, true)
			-- draw-in
			safeGuiTween(clip, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(PLOT_W, PLOT_H) })

			local obj = {}
			function obj:Set(list) setData(list); return obj end
			function obj:Add(v)
				local list = table.clone(data)
				list[#list + 1] = v
				setData(list)
				return obj
			end
			function obj:Clear() setData({}, true); return obj end
			function obj:Get() return table.clone(data) end
			function obj:GetLast() return data[#data] end
			function obj:SetColor(c) if typeof(c) == "Color3" then color = c; draw() end; return obj end
			function obj:SetRange(lo, hi) loFixed, hiFixed = lo, hi; draw(); return obj end
			return finalize(row, obj)
		end


