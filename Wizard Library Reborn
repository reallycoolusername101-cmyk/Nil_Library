-- Extra roles are derived from the five base colours so EVERY surface, border, grid line
-- and text colour in the library follows the theme (see deriveRoles / applyTheme).
local function shade(c, d)
	return Color3.fromRGB(
		math.clamp(math.round(c.R * 255 + d), 0, 255),
		math.clamp(math.round(c.G * 255 + d), 0, 255),
		math.clamp(math.round(c.B * 255 + d), 0, 255)
	)
end
local function deriveRoles(t)
	t.Text = t.Text or Color3.new(1, 1, 1)
	t.SubText = t.SubText or Color3.fromRGB(178, 178, 178)
	t.Accent2 = t.Accent2 or t.Accent
	t.Accent3 = t.Accent3 or t.Accent2
	t.Deep = shade(t.Window, -5)    -- tooltips, notification cards
	t.Plot = shade(t.Window, -7)    -- chart / viewport backgrounds
	t.Track = shade(t.Window, 2)    -- sparkline + scrub tracks
	t.Knob = shade(t.Section, 3)
	t.Raised = shade(t.Widget, -15)
	t.Hover = shade(t.Widget, -10)  -- option hover
	t.Stroke = shade(t.Widget, 5)   -- outlines
	t.Grid = shade(t.Section, -3)   -- chart grid lines
	t.Axis = shade(t.Widget, 55)    -- chart axis lines
	return t
end
deriveRoles(COLORS)

