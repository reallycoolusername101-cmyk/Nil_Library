		BorderSizePixel = 0,
		Position = UDim2.fromOffset(3,4),
		Size = UDim2.fromOffset(CARD_W,CARD_H),
		ZIndex = 90,
	}, entry)
	corner(shadow,9)

	local card = create('Frame', {
		BackgroundColor3 = COLORS.Deep,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(CARD_W,CARD_H),
