local function sameColor(a, b)
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.012
end

-- gradient strips (window title underline, pop-out top edge). Single-colour themes get a soft
-- accent->lighter-accent fade, multi-colour themes blend Accent -> Accent2 -> Accent3.
local gradients = setmetatable({}, { __mode = "k" })
local function accentSequence()
	local t = THEMES[currentTheme]
	if t.Multi then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, t.Accent),
			ColorSequenceKeypoint.new(0.5, t.Accent2),
			ColorSequenceKeypoint.new(1, t.Accent3),
		})
	end
	return ColorSequence.new(t.Accent, t.Accent:Lerp(Color3.new(1, 1, 1), 0.25))
end
local function themeGradient(frame)
	local g = create("UIGradient", { Name = "ThemeGradient", Color = accentSequence() }, frame)
	gradients[g] = true
	return g
end

local function applyTheme(name)
	local t = THEMES[name]
	if not t then
		return
	end
	local old = {}
	for role, col in pairs(t) do
		if typeof(col) == "Color3" then
			old[role] = COLORS[role]
			COLORS[role] = col
		end
	end
	currentTheme = name

	-- chart palette follows the theme for series created from now on
	local pal = t.Multi and { t.Accent, t.Accent2, t.Accent3 } or { t.Accent }
	for i = 1, #PALETTE_BASE do
		PALETTE[i] = pal[i] or PALETTE_BASE[i]
	end

	-- recolour by what each object is showing right now, so an object that is currently
	-- highlighted (accent) stays highlighted in the new theme
	for inst, props in pairs(themed) do
		if inst.Parent then
			for prop, role0 in pairs(props) do
				local ok, cur = pcall(function() return inst[prop] end)
				if ok and typeof(cur) == "Color3" then
					local target
					if old[role0] and sameColor(cur, old[role0]) then
						target = role0
					else
						for _, role in ipairs(THEME_PROPS[prop]) do
							if old[role] and sameColor(cur, old[role]) then
								target = role
								break
							end
						end
					end
					if target and COLORS[target] then
						inst[prop] = COLORS[target]
					end
				end
			end
		end
	end
	for g in pairs(gradients) do
		if g.Parent then g.Color = accentSequence() end
	end
	if Library.OnThemeChanged then
		pcall(Library.OnThemeChanged, name)
	end
end

function Library:SetTheme(name)
	applyTheme(name)
	return self
end
function Library:GetTheme()
	return currentTheme
end
function Library:GetThemes()
	return table.clone(THEME_ORDER)
end
-- colors = {Window, Body, Section, Widget, Accent, [Accent2, Accent3, Text, SubText]}
-- giving Accent2 makes it a multi-colour theme. Missing colours fall back to the current theme.
function Library:AddTheme(name, colors)
	if type(name) ~= "string" or type(colors) ~= "table" then return self end
	local base = THEMES[currentTheme]
	local t = {}
	for _, role in ipairs({ "Window", "Body", "Section", "Widget", "Accent" }) do
		t[role] = (typeof(colors[role]) == "Color3") and colors[role] or base[role]
	end
	for _, role in ipairs({ "Text", "SubText", "Accent2", "Accent3" }) do
		if typeof(colors[role]) == "Color3" then t[role] = colors[role] end
	end
	t.Multi = typeof(colors.Accent2) == "Color3"
	deriveRoles(t)
	if not THEMES[name] then
		table.insert(THEME_ORDER, name)
	end
	THEMES[name] = t
	return self
end
-- adds a theme dropdown (applies instantly) to any section
function Library:CreateThemeDropdown(section, name)
	local index = table.find(THEME_ORDER, currentTheme) or 1
	return section:CreateDropdown(name or "Theme", THEME_ORDER, index, function(choice)
		applyTheme(choice)
	end)
end

local function closeSettings()
	if not settingsOpen then
		return
	end
	settingsOpen = false
	for _, w in ipairs(allWindows) do
		if not (globalSettingsWindow and w.Frame == globalSettingsWindow.Frame) then
			w.Frame.Visible = not w.Window.Hidden
		end
	end
	if globalSettingsWindow then
		globalSettingsWindow.Frame.Visible = false
	end
end

local function buildGlobalSettingsWindow()
	local w = Library:NewWindow("Settings")

	local generalSec = w:NewSection("General")
	generalSec:CreateButton("Unload UI", function()
		gui:Destroy()
	end)
	generalSec:CreateButton("Close Settings", function()
		closeSettings()
	end)

	local themeSec = w:NewSection("Theme")
	Library:CreateThemeDropdown(themeSec, "Theme")

	windowsSection = w:NewSection("Windows")

	local sizeSec = w:NewSection("UI Size")
	Library:CreateUIScaleControls(sizeSec)

	return w
end

local function openSettings()
	if settingsOpen then
		return
	end
	settingsOpen = true
	if not globalSettingsWindow then
		globalSettingsWindow = buildGlobalSettingsWindow()
	end
	for _, w in ipairs(allWindows) do
		if not (globalSettingsWindow and w.Frame == globalSettingsWindow.Frame) then
			w.Frame.Visible = false
		end
	end
	refreshWindowToggles()
	for _, w in ipairs(allWindows) do
		if not (globalSettingsWindow and w.Frame == globalSettingsWindow.Frame) then
			w.Frame.Visible = false
		end
	end
	globalSettingsWindow.Frame.Visible = true
	globalSettingsWindow.Frame.Position = UDim2.fromOffset(220, 90)
end

Library.UIScale = {
	Enabled = true,
	Presets = {
		Small = 0.82,
		Medium = 1.00,
		Large = 1.16,
		XL = 1.32,
	},
	Current = "Medium",
}

function Library:SetUIScale(value)
	if not self.UIScale.Enabled then
		return self
	end

	local scale

	if type(value) == "number" then
		scale = value
	else
		local key = tostring(value or "Medium")
		local presets = self.UIScale.Presets
		scale = presets[key]

		if scale then
			self.UIScale.Current = key
		else
			scale = presets.Medium
			self.UIScale.Current = "Medium"
		end
	end

	if type(scale) ~= "number" or scale ~= scale or scale <= 0 then
		scale = 1
	end

	scale = math.clamp(scale, 0.55, 1.6)
	tween(uiScale, { Scale = scale })
	return self
end

function Library:GetUIScale()
	return uiScale.Scale
end

function Library:ConfigureUIScale(cfg)
	cfg = cfg or {}

	if cfg.Enabled ~= nil then
		self.UIScale.Enabled = cfg.Enabled and true or false
	end

	if type(cfg.Presets) == "table" then
		for key, value in pairs(cfg.Presets) do
			if type(value) == "number" and value > 0 then
				self.UIScale.Presets[key] = value
			end
		end
	end

	if cfg.Default ~= nil then
		self:SetUIScale(cfg.Default)
	elseif self.UIScale.Enabled then
		self:SetUIScale(self.UIScale.Current or "Medium")
	end

	return self
end

-- Adds the four scale buttons to an existing section.
-- Config:
--   Library:CreateUIScaleControls(section, {
--       Small = 0.82, Medium = 1, Large = 1.16, XL = 1.32,
--       Default = "Medium",
--   })
function Library:CreateUIScaleControls(section, cfg)
	cfg = cfg or {}

	self:ConfigureUIScale({
		Presets = {
			Small = cfg.Small,
			Medium = cfg.Medium,
			Large = cfg.Large,
			XL = cfg.XL,
		},
		Default = cfg.Default or self.UIScale.Current or "Medium",
	})

	local controls = {}

	controls.Small = section:CreateButton("Small", function()
		self:SetUIScale("Small")
	end)

	controls.Medium = section:CreateButton("Medium", function()
		self:SetUIScale("Medium")
	end)

	controls.Large = section:CreateButton("Large", function()
		self:SetUIScale("Large")
	end)

	controls.XL = section:CreateButton("XL", function()
		self:SetUIScale("XL")
	end)

	function controls:Set(value)
		self.ParentLibrary:SetUIScale(value)
		return self
	end

	controls.ParentLibrary = self
	return controls
end

