			local function updateSV(input)
				local p = pointerPos(input)
				sat = clamp01((p.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X)
				val = 1 - clamp01((p.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y)
				refresh(true)
			end
			local function updateHue(input)
				local p = pointerPos(input)
				hue = clamp01((p.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y)
				refresh(true)
			end

			svBox.InputBegan:Connect(function(input)
				if isPress(input) then
					if not (svDragging or hueDragging) then holdScroll(true) end
					svDragging = true
					updateSV(input)
				end
			end)
			hueBar.InputBegan:Connect(function(input)
				if isPress(input) then
					if not (svDragging or hueDragging) then holdScroll(true) end
					hueDragging = true
					updateHue(input)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if isPress(input) then
					if svDragging or hueDragging then holdScroll(false) end
					svDragging, hueDragging = false, false
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if not isMove(input) then
					return
				end
				if svDragging then
					updateSV(input)
				elseif hueDragging then
					updateHue(input)
				end
			end)

			local rainbow = false
			local rainbowConn
			rainbowClick.MouseButton1Click:Connect(function()
				rainbow = not rainbow
				tween(rainbowFill, { BackgroundTransparency = rainbow and 0 or 1 })
				if rainbow then
					rainbowConn = RunService.RenderStepped:Connect(function()
						if not gui.Parent then
							rainbowConn:Disconnect()
							return
						end
						hue = (tick() % 5) / 5
						sat, val = 1, 1
						refresh(true)
					end)
				elseif rainbowConn then
					rainbowConn:Disconnect()
					rainbowConn = nil
				end
			end)

			local obj = {}
			function obj:Set(color)
				hue, sat, val = color:ToHSV()
				refresh(true)
			end
			function obj:Get()
				return Color3.fromHSV(hue, sat, val)
			end
			function obj:GetRGB()
				local c = Color3.fromHSV(hue, sat, val)
				return math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
			end
			function obj:GetHex()
				local r, g, b = obj:GetRGB()
				return string.format("#%02X%02X%02X", r, g, b)
			end
			function obj:GetHSV()
				return hue, sat, val
			end
			function obj:IsRainbow()
				return rainbow
			end
			function obj:IsOpen()
				return open
			end
			return finalize(row, obj)
		end


		function Section:CreateComparison(name, fromValue, toValue, options)
			options = options or {}
			local row = newRow(name .. "Comparison")
			row.Size = UDim2.new(0, WIDTH, 0, 42)

			label(row, name, UDim2.fromOffset(9, 2), UDim2.fromOffset(82, 17), Enum.Font.SourceSansSemibold, 12)
			local valueLabel = label(row, "", UDim2.fromOffset(9, 19), UDim2.fromOffset(152, 18), Enum.Font.SourceSansBold, 13, Enum.TextXAlignment.Left)

			local unit = tostring(options.Unit or "")
			local rate = options.Rate or options.ConversionRate
			local function format(v)
				return Library:FormatNumber(v, {Unit = unit, Rate = rate})
			end

			local function render(a, b)
				local result = Library:CompareValues(a, b)
				local pText
				if result.Percent == math.huge then
					pText = (result.Difference < 0 and "-inf%" or "+inf%")
				elseif result.Direction == "unchanged" then
					pText = "+0.00%"
				else
					pText = string.format("%+.2f%%", result.Percent)
				end
				valueLabel.Text = format(a) .. " -> " .. format(b) .. "  (" .. pText .. ")"
				valueLabel.TextColor3 = result.Direction == "increase" and Color3.fromRGB(120,220,120)
					or result.Direction == "decrease" and COLORS.Accent
					or COLORS.SubText
			end

			render(tonumber(fromValue) or 0, tonumber(toValue) or 0)

			local obj = {}
			function obj:Set(a, b)
				fromValue, toValue = a, b
				render(tonumber(a) or 0, tonumber(b) or 0)
				return obj
			end
			function obj:Get()
				return tonumber(fromValue) or 0, tonumber(toValue) or 0
			end
			return finalize(row, obj)
		end

