			create("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,3)},scroll)
			local filter=options.Levels
			local unsubscribe

			local function allowed(level)
				if type(filter)~="table" then return true end
				for _,v in ipairs(filter) do if tostring(v)==level then return true end end
				return false
			end
			local function addEntry(entry)
				if not entry or not allowed(entry.Level) then return end
				local item=create("Frame",{BackgroundColor3=COLORS.Widget,BackgroundTransparency=0.12,BorderSizePixel=0,Size=UDim2.new(1,-8,0,40),LayoutOrder=#scroll:GetChildren()},scroll)
