local chartTipToken = 0
local chartTipOwner = nil
local chartTipKey = nil
local CHART_TOOLTIP_DELAY = 1

-- Chart hover text appears after one second of staying on the same target.
-- The target key is stable, so mouse-move spam cannot keep restarting the timer.
local function instantChartTooltip(owner, header, body, key)
	if not owner then
		return
	end

	if not (header or body) then
		chartTipToken += 1
		chartTipOwner = nil
		chartTipKey = nil
		hideTip(owner)
		return
	end

	if not Library.Tooltips.Enabled or not owner.Parent then
		chartTipToken += 1
		chartTipOwner = nil
		chartTipKey = nil
		hideTip(owner)
		return
	end

	header = header and tostring(header) or nil
	body = body and tostring(body) or nil
	key = tostring(key or ((header or "") .. "\0" .. (body or "")))

	if chartTipOwner == owner and chartTipKey == key then
		return
	end

	chartTipToken += 1
	local token = chartTipToken
	chartTipOwner = owner
	chartTipKey = key

	task.delay(CHART_TOOLTIP_DELAY, function()
		if token ~= chartTipToken then
			return
		end

		if chartTipOwner ~= owner or chartTipKey ~= key then
			return
		end

		if not Library.Tooltips.Enabled then
			return
		end

		if not owner.Parent then
			chartTipToken += 1
			chartTipOwner = nil
			chartTipKey = nil
			return
		end

		showTip(owner, {
			Header = header,
			Text = body,
			Delay = 0,
			Duration = 0,
			Enabled = true,
		})
	end)
end

