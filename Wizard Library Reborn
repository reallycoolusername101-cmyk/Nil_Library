		function Section:CreateSlider(name, min, max, default, precise, callback)
			callback = callback or function() end
			min = min or 0
			max = max or 100
			local value = math.clamp(default or min, min, max)

			local row = newRow(name .. "Slider")
			label(row, name, UDim2.new(0.053, 0, 0, 0), UDim2.new(0, 105, 0, 15), Enum.Font.SourceSansSemibold)
				.Name = "SliderTitle"

			local valueBox = create("Frame", {
				Name = "SliderValueHolder",
				BackgroundColor3 = COLORS.Widget,
				BorderSizePixel = 0,
				Position = UDim2.new(1, -45, 0, 0),
				Size = UDim2.new(0, 35, 0, 15),
			}, row)
			corner(valueBox, 3)

			local valueLabel = label(valueBox, "", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0),
				Enum.Font.SourceSansSemibold, 14, Enum.TextXAlignment.Center)
			valueLabel.Name = "SliderValue"

			local track = create("Frame", {
				Name = "SliderBackground",
				BackgroundColor3 = COLORS.Widget,
				BorderSizePixel = 0,
				Position = UDim2.new(0.053, 0, 0, 20),
				Size = UDim2.new(0, 153, 0, 5),
				ClipsDescendants = true,
			}, row)
			corner(track, 3)

			local bar = create("Frame", {
				Name = "Slider",
				BackgroundColor3 = COLORS.Accent,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 0, 1, 0),
			}, track)
			corner(bar, 3)

			local function format(v)
				if precise then
					return tonumber(string.format("%.2f", v))
				end
				return math.floor(v + 0.5)
			end

			local function setValue(v, animate)
				value = format(math.clamp(v, min, max))
				local alpha = (max == min) and 0 or (value - min) / (max - min)
				valueLabel.Text = tostring(value)
				if animate then
					tween(bar, { Size = UDim2.new(alpha, 0, 1, 0) })
				else
					bar.Size = UDim2.new(alpha, 0, 1, 0)
				end
			end
			setValue(value, false)

			local dragging = false
			local function update(input)
				local alpha = clamp01((pointerPos(input).X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
				setValue(min + (max - min) * alpha, true)
				callback(value)
			end

			track.InputBegan:Connect(function(input)
				if isPress(input) then
					if not dragging then holdScroll(true) end
					dragging = true
					update(input)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if isPress(input) then
					if dragging then holdScroll(false) end
					dragging = false
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if dragging and isMove(input) then
					update(input)
				end
			end)

			local obj = {}
			function obj:Set(v)
				setValue(v, true)
				callback(value)
			end
			function obj:Get()
				return value
			end
			function obj:GetRange()
				return min, max
			end
			return finalize(row, obj)
		end

