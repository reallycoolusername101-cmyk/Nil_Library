		-- Keybind --------------------------------------------------------
		function Section:CreateKeybind(name, default, callback, onChanged)
			callback = callback or function() end
			local key = default
			local row = newRow(name .. "Keybind")
			label(row, name, UDim2.new(0.053, 0, 0, 0), UDim2.new(0, 90, 0, ROW)).Name = "KeybindTitle"

			local btn = newButton(row, key and key.Name or "None", UDim2.fromOffset(WIDTH - 70, 3), UDim2.fromOffset(62, 24))
			btn.Name = "KeybindButton"

			local listening = false
			local function render()
				btn.Text = listening and "..." or (key and key.Name or "None")
				tween(btn, { BackgroundColor3 = listening and COLORS.Accent or COLORS.Widget })
			end

			btn.MouseButton1Click:Connect(function()
				if listening then
					return
				end
				listening = true
				rebinding = true
				render()
			end)

			UIS.InputBegan:Connect(function(input, processed)
				if listening then
					if input.UserInputType ~= Enum.UserInputType.Keyboard then
						return
					end
					listening = false
					rebinding = false
					rebindInput = input
					if input.KeyCode == Enum.KeyCode.Escape then
						-- cancelled, keep the old key
					elseif input.KeyCode == Enum.KeyCode.Backspace then
						key = nil
						if onChanged then
							onChanged(nil)
						end
					else
						key = input.KeyCode
						if onChanged then
							onChanged(key)
						end
					end
					render()
					return
				end
				if processed or rebinding or rebindInput == input then
					return
				end
				if key and input.KeyCode == key then
					callback(key)
				end
			end)

			local obj = {}
			function obj:SetKey(k)
				key = k
				render()
			end
			function obj:GetKey()
				return key
			end
			function obj:Get()
				return key
			end
			function obj:GetName()
				return key and key.Name or "None"
			end
			function obj:IsListening()
				return listening
			end
			return finalize(row, obj)
		end

		-- Graph ----------------------------------------------------------
		function Section:CreateGraph(name, options)
			options = options or {}
			local PW, PH = 324, 180
			local PANEL_W, PANEL_H = 380, 292
			local PLOT_X, PLOT_Y = 46, 38

			local xmin, xmax = options.XMin or -10, options.XMax or 10
			local ymin, ymax = options.YMin or -10, options.YMax or 10
			local autoFit = options.AutoFit ~= false and options.XMin == nil

			local series, order, paletteIndex = {}, {}, 0
			local graph = {}

			local row = newRow(name .. "Graph")
			local openBtn = newButton(row, name .. "  >", UDim2.new(0.053, 0, 0, 3), UDim2.new(0, 153, 0, 24))
			openBtn.Name = "Button"

			local d = dock(window, PANEL_W, PANEL_H, options.Title or name, safeName .. "GraphPanel")
			local closeBtn = d.closeBtn
						local fitBtn = d.barButton("Fit", PANEL_W - 128, 40)
			local clearBtn = d.barButton("Clear", PANEL_W - 82, 46)

			local plot = create("Frame", {
				Name = "Plot",
				BackgroundColor3 = COLORS.Plot,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(PLOT_X, PLOT_Y),
				Size = UDim2.fromOffset(PW, PH),
			}, d.panel)
			create("UIStroke", { Color = COLORS.Stroke, Thickness = 1 }, plot)

			local gridLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 1 }, plot)
			local lineLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2 }, plot)
			local hoverLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 8 }, plot)
			local hit = hoverCapture(plot, 12)
			local tickLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0) }, d.panel)

			local vLine = create("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.62,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(1, PH),
				Visible = false,
				ZIndex = 13,
			}, plot)
			local hLine = create("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.62,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(PW, 1),
				Visible = false,
				ZIndex = 13,
			}, plot)
			local cursorDot = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(9, 9),
				Visible = false,
				ZIndex = 14,
			}, plot)
			corner(cursorDot, 5)
			create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, cursorDot)

			local readout = label(d.panel, "x: --   y: --", UDim2.fromOffset(PLOT_X, PLOT_Y + PH + 20), UDim2.fromOffset(PW, 16), Enum.Font.SourceSans, 14)
			readout.TextColor3 = COLORS.SubText

			local legend = create("ScrollingFrame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(8, PLOT_Y + PH + 42),
				Size = UDim2.fromOffset(PANEL_W - 16, 28),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				ScrollingDirection = Enum.ScrollingDirection.X,
				ScrollBarThickness = 2,
			}, d.panel)
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
			}, legend)

			local isOpen = false
			local graphCoordinatePoll
			local panning, panStart, panView = false, nil, nil

			local function ensure(id, color)
				if not series[id] then
					paletteIndex += 1
					series[id] = {
						Name = tostring(id),
						Color = color or PALETTE[(paletteIndex - 1) % #PALETTE + 1],
						Points = {},
					}
					table.insert(order, id)
				elseif color then
					series[id].Color = color
				end
				return series[id]
			end

			local function rebuildLegend()
			local entries = {}
			for _, id in ipairs(order) do
				local s = series[id]
				if s then
					entries[#entries + 1] = { id = id, name = s.Name, color = s.Color }
				end
			end
			buildChips(legend, entries, function(id)
				graph:Remove(id)
			end)
		end

			local function fit()
				local x1, x2, y1, y2 = math.huge, -math.huge, math.huge, -math.huge

				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						for _, p in ipairs(s.Points) do
							if p[2] ~= nil then
								x1, x2 = math.min(x1, p[1]), math.max(x2, p[1])
								y1, y2 = math.min(y1, p[2]), math.max(y2, p[2])
							end
						end

						if s.Fn then
							local a, b = s.XMin or xmin, s.XMax or xmax
							local steps = math.clamp(s.Steps or 150, 20, 300)
							for i = 0, steps do
								local x = a + (b - a) * i / steps
								local ok, y = pcall(s.Fn, x)
								if ok and type(y) == "number" and y == y and math.abs(y) < 1e9 then
									x1, x2 = math.min(x1, x), math.max(x2, x)
									y1, y2 = math.min(y1, y), math.max(y2, y)
								end
							end
						end
					end
				end

				if x1 == math.huge then
					return
				end
				if x2 - x1 < 1e-9 then x1, x2 = x1 - 1, x2 + 1 end
				if y2 - y1 < 1e-9 then y1, y2 = y1 - 1, y2 + 1 end

				local px, py = (x2 - x1) * 0.08, (y2 - y1) * 0.08
				xmin, xmax = x1 - px, x2 + px
			ymin, ymax = y1 - py, y2 + py
			end

			local function hideCursor()
				vLine.Visible = false
				hLine.Visible = false
				cursorDot.Visible = false
				readout.Text = "x: --   y: --"
				instantChartTooltip(hit)
			end

			local function redraw(animated)
				gridLayer:ClearAllChildren()
				lineLayer:ClearAllChildren()
				tickLayer:ClearAllChildren()

				local xr = math.max(1e-12, xmax - xmin)
				local yr = math.max(1e-12, ymax - ymin)

				local xs = niceStep(xr, 6)
				local x0 = math.ceil(xmin / xs - 1e-9)
				local x1 = math.floor(xmax / xs + 1e-9)
				if x1 - x0 <= 60 then
					for k = x0, x1 do
						local v = k * xs
						local px = (v - xmin) / xr * PW
						create("Frame", {
							BackgroundColor3 = k == 0 and COLORS.Axis or COLORS.Grid,
							BorderSizePixel = 0,
							Position = UDim2.fromOffset(px, 0),
							Size = UDim2.fromOffset(k == 0 and 2 or 1, PH),
						}, gridLayer)
						local l = label(tickLayer, fmt(v), UDim2.fromOffset(PLOT_X + px - 25, PLOT_Y + PH + 3), UDim2.fromOffset(50, 14), Enum.Font.SourceSans, 12, Enum.TextXAlignment.Center)
						l.TextColor3 = COLORS.SubText
					end
				end

				local ys = niceStep(yr, 5)
				local y0 = math.ceil(ymin / ys - 1e-9)
				local y1 = math.floor(ymax / ys + 1e-9)
				if y1 - y0 <= 60 then
					for k = y0, y1 do
						local v = k * ys
						local py = PH - (v - ymin) / yr * PH
						create("Frame", {
							BackgroundColor3 = k == 0 and COLORS.Axis or COLORS.Grid,
							BorderSizePixel = 0,
							Position = UDim2.fromOffset(0, py),
							Size = UDim2.fromOffset(PW, k == 0 and 2 or 1),
						}, gridLayer)
						local l = label(tickLayer, fmt(v), UDim2.fromOffset(0, PLOT_Y + py - 7), UDim2.fromOffset(42, 14), Enum.Font.SourceSans, 12, Enum.TextXAlignment.Right)
						l.TextColor3 = COLORS.SubText
					end
				end

				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						local points = s.Points
						if s.Fn then
							points = {}
							local a, b = s.XMin or xmin, s.XMax or xmax
							local steps = math.clamp(s.Steps or 150, 20, 600)
							for i = 0, steps do
								local x = a + (b - a) * i / steps
								local ok, y = pcall(s.Fn, x)
								if ok and type(y) == "number" and y == y and math.abs(y) < 1e9 then
									points[#points + 1] = { x, y }
								else
									points[#points + 1] = { x }
								end
							end
							s.Sampled = points
						end

						local stride = math.max(1, math.ceil(#points / 600))
						local prevX, prevY
						local pointIndex = 0

						for i = 1, #points, stride do
							local p = points[i]
							if p[2] == nil then
								prevX, prevY = nil, nil
							else
								pointIndex += 1
								local rx = (p[1] - xmin) / xr * PW
								local ry = PH - (p[2] - ymin) / yr * PH

								if prevX then
									local outside = (rx < 0 and prevX < 0) or (rx > PW and prevX > PW) or (ry < 0 and prevY < 0) or (ry > PH and prevY > PH)
									local jump = s.Fn and math.abs(ry - prevY) > PH * 3
									if not outside and not jump then
										if animated and #points < 260 then
											drawAnimatedSegment(lineLayer, prevX, prevY, rx, ry, s.Color, 0.16)
										else
											segment(lineLayer, prevX, prevY, rx, ry, s.Color, 2)
										end
									end
								end

								if #points <= 50 and rx >= 0 and rx <= PW and ry >= 0 and ry <= PH then
									local dot = create("Frame", {
										AnchorPoint = Vector2.new(0.5, 0.5),
										BackgroundColor3 = s.Color,
										BorderSizePixel = 0,
										Position = UDim2.fromOffset(rx, ry),
										Size = UDim2.fromOffset(6, 6),
									}, lineLayer)
									corner(dot, 3)
									if animated then
										local sc = create("UIScale", { Scale = 0.2 }, dot)
										tween(sc, { Scale = 1 })
									end
								end

								prevX, prevY = rx, ry
							end
						end
					end
				end
			end

			local function updateCursor()
				if not isOpen then
					return
				end

				local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
				if rel.X < 0 or rel.Y < 0 or rel.X > PW or rel.Y > PH then
					hideCursor()
					return
				end

				local xr, yr = xmax - xmin, ymax - ymin
				local best, bestDist = nil, 14

				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						local points = s.Fn and s.Sampled or s.Points
						for index, p in ipairs(points or {}) do
							if p[2] ~= nil then
								local px = (p[1] - xmin) / xr * PW
								local py = PH - (p[2] - ymin) / yr * PH
								local dist = math.sqrt((px - rel.X)^2 + (py - rel.Y)^2)
								if dist < bestDist then
									bestDist = dist
									best = { px = px, py = py, x = p[1], y = p[2], name = s.Name, index = index, color = s.Color }
								end
							end
						end
					end
				end

			local cx, cy = rel.X, rel.Y
			if best then
				cx, cy = best.px, best.py
				cursorDot.Visible = true
				cursorDot.Position = UDim2.fromOffset(cx, cy)
				cursorDot.BackgroundColor3 = best.color
				readout.Text = string.format("%s   x: %s   y: %s", best.name, fmt(best.x), fmt(best.y))
				instantChartTooltip(hit, best.name, "x = " .. fmt(best.x) .. "\ny = " .. fmt(best.y) .. "\nSample #" .. tostring(best.index), "graph:" .. tostring(best.name) .. ":" .. tostring(best.index))
			else
				cursorDot.Visible = false
				local x = xmin + rel.X / PW * xr
				local y = ymax - rel.Y / PH * yr
				readout.Text = "x: " .. fmt(x) .. "   y: " .. fmt(y)
				instantChartTooltip(hit, "Coordinates", "x = " .. fmt(x) .. "\ny = " .. fmt(y), "coords")
			end

			vLine.Visible = true
			hLine.Visible = true
			vLine.Position = UDim2.fromOffset(cx, 0)
			hLine.Position = UDim2.fromOffset(0, cy)
		end

		graphCoordinatePoll = RunService.RenderStepped:Connect(function()
			if not d.isOpen then return end
			local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
			if rel.X >= 0 and rel.Y >= 0 and rel.X <= PW and rel.Y <= PH then
				updateCursor()
			elseif vLine.Visible or hLine.Visible then
				hideCursor()
			end
		end)

		hit.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				updateCursor()
			elseif input.UserInputType == Enum.UserInputType.MouseWheel then
				local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
				if rel.X < 0 or rel.Y < 0 or rel.X > PW or rel.Y > PH then
					return
				end

				local mx = clamp01(rel.X / PW)
				local my = clamp01(1 - rel.Y / PH)
				local cx = xmin + mx * (xmax - xmin)
				local cy = ymin + my * (ymax - ymin)
				local factor = input.Position.Z > 0 and 0.82 or (1 / 0.82)

				xmin, xmax = cx - (cx - xmin) * factor, cx + (xmax - cx) * factor
				ymin, ymax = cy - (cy - ymin) * factor, cy + (ymax - cy) * factor
				autoFit = false
				redraw(false)
				updateCursor()
			end
		end)

		-- Panning: left mouse button or a single finger drags the view
		-- around. Uses pointerPos() (rather than raw UIS:GetMouseLocation())
		-- so touch and mouse share the same coordinate space.
		hit.InputBegan:Connect(function(input)
			if isPress(input) then
				panning = true
				panStart = pointerPos(input)
				panView = { xmin, xmax, ymin, ymax }
			end
		end)

		hit.MouseLeave:Connect(function()
			hideCursor()
		end)

		UIS.InputEnded:Connect(function(input)
			if isPress(input) then
				panning = false
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if panning and (isMove(input) or input.UserInputType == Enum.UserInputType.Touch) then
				local m = pointerPos(input)
				local dx = (m.X - panStart.X) / PW * (panView[2] - panView[1])
				local dy = (m.Y - panStart.Y) / PH * (panView[4] - panView[3])
				xmin, xmax = panView[1] - dx, panView[2] - dx
				ymin, ymax = panView[3] + dy, panView[4] + dy
				autoFit = false
				redraw(false)
				updateCursor()
			end
		end)

		d.onToggle = function(state)
			-- this local `isOpen` (distinct from d.isOpen) gates the cursor
			-- poll below; it was never being set, so the readout always
			-- bailed out immediately and coordinates never appeared.
			isOpen = state
			openBtn.Text = name .. (state and "  <" or "  >")
			tween(openBtn, { BackgroundColor3 = state and COLORS.Accent or COLORS.Widget })
				setChartSelected(openBtn, state)
			if state then
				if autoFit then
					fit()
				end
				redraw(true)
				updateCursor()
			else
				hideCursor()
			end
		end

		openBtn.MouseButton1Click:Connect(function()
			d.setOpen(not d.isOpen)
		end)
		closeBtn.MouseButton1Click:Connect(function()
			d.setOpen(false)
		end)
		clearBtn.MouseButton1Click:Connect(function()
			graph:Clear()
		end)
		fitBtn.MouseButton1Click:Connect(function()
			autoFit = true
			fit()
			redraw(true)
			updateCursor()
		end)

		function graph:Plot(id, points, color)
			local s = ensure(id, color)
			s.Fn, s.Sampled = nil, nil
			s.Points = normalizePoints(points)
			if autoFit then fit() end
			rebuildLegend()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:PlotFunction(id, fn, opts)
			if typeof(opts) == "Color3" then opts = { Color = opts } end
			opts = opts or {}
			local s = ensure(id, opts.Color)
			s.Fn = fn
			s.Steps = math.clamp(opts.Steps or 150, 20, 600)
			s.XMin, s.XMax = opts.XMin, opts.XMax
			s.Points = {}
			if autoFit then fit() end
			rebuildLegend()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:AddPoint(id, x, y)
			local s = ensure(id)
			s.Fn = nil
			s.Points[#s.Points + 1] = { x, y }
			if autoFit then fit() end
			rebuildLegend()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:AddPoints(id, points)
			local s = ensure(id)
			s.Fn = nil
			for _, p in ipairs(normalizePoints(points)) do
				s.Points[#s.Points + 1] = p
			end
			if autoFit then fit() end
			rebuildLegend()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:RemovePoint(id, index)
			local s = series[id]
			if s and #s.Points > 0 then
				table.remove(s.Points, index or #s.Points)
				if autoFit then fit() end
				if d.isOpen then redraw(true) end
			end
			return graph
		end

		function graph:Remove(id)
			if series[id] then
				series[id] = nil
				local index = table.find(order, id)
				if index then table.remove(order, index) end
				if autoFit then fit() end
				rebuildLegend()
				if d.isOpen then redraw(true) end
			end
			return graph
		end

		function graph:Clear()
			series, order, paletteIndex = {}, {}, 0
			rebuildLegend()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:SetRange(x1, x2, y1, y2)
			xmin, xmax, ymin, ymax = x1, x2, y1, y2
			autoFit = false
			if d.isOpen then
				redraw(false)
				updateCursor()
			end
			return graph
		end

		function graph:Fit()
			autoFit = true
			fit()
			if d.isOpen then redraw(true) end
			return graph
		end

		function graph:SetTitle(t)
			d.title.Text = tostring(t)
			return graph
		end

		-- { [seriesId] = { Points = {{x,y}...}, Color = Color3, IsFunction = bool } }
		function graph:Get()
			local out = {}
			for _, id in ipairs(order) do
				local s = series[id]
				if s then
					local pts = {}
					for i, p in ipairs(s.Points) do pts[i] = { p[1], p[2] } end
					out[id] = { Points = pts, Color = s.Color, IsFunction = s.Fn ~= nil }
				end
			end
			return out
		end
		function graph:GetRange() return xmin, xmax, ymin, ymax end
		function graph:Open() d.setOpen(true) end
		function graph:Close() d.setOpen(false) end
		function graph:Toggle() d.setOpen(not d.isOpen) end
		function graph:IsOpen() return d.isOpen end

		return finalize(row, graph):SetTooltip({
			Header = "Graph",
			Text = "Wheel = zoom\nDrag = pan\nHover = coordinates\nFit = frame the data",
		})
		end

		-- Bar chart ------------------------------------------------------
		function Section:CreateBarChart(name, options)
			options = options or {}
			local PANEL_W, PANEL_H = 380, 292
			local PLOT_X, PLOT_Y, PW, PH = 46, 38, 324, 190
			local items = normalizeItems(options.Data)
			local fixedMin, fixedMax = options.YMin, options.YMax
			local showValues = options.ShowValues ~= false
			local chart = {}
			local barHoverPoll
			local hoverPoll

			local row = newRow(name .. "BarChart")
			local openBtn = newButton(row, name .. "  >", UDim2.new(0.053, 0, 0, 3), UDim2.new(0, 153, 0, 24))
			openBtn.Name = "Button"

			local d = dock(window, PANEL_W, PANEL_H, options.Title or name, safeName .. "BarPanel")
			local fitBtn = d.barButton("Fit", PANEL_W - 128, 40)
			local clearBtn = d.barButton("Clear", PANEL_W - 82, 46)

			local plot = create("Frame", {
				BackgroundColor3 = COLORS.Plot,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(PLOT_X, PLOT_Y),
				Size = UDim2.fromOffset(PW, PH),
			}, d.panel)
			create("UIStroke", { Color = COLORS.Stroke, Thickness = 1 }, plot)

			local gridLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 1 }, plot)
			local barLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2 }, plot)
			local hit = hoverCapture(plot, 12)
			local tickLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0) }, d.panel)

			local readout = label(d.panel, "Hover a bar", UDim2.fromOffset(PLOT_X, PLOT_Y + PH + 22), UDim2.fromOffset(PW, 16), Enum.Font.SourceSans, 14)
			readout.TextColor3 = COLORS.SubText

			local startIndex, endIndex = 1, math.max(1, #items)
			local bars = {}
			local slot = PW
			local hoverIndex
			local dragging, dragX, dragStart, dragEnd = false, 0, 1, 1

			local function resetView()
				startIndex, endIndex = 1, math.max(1, #items)
			end

			local function getRange()
				local lo, hi = 0, 0
				for _, item in ipairs(items) do
					if type(item.Value) == "number" then
						lo = math.min(lo, item.Value)
						hi = math.max(hi, item.Value)
					end
				end
				if fixedMin ~= nil then lo = fixedMin end
				if fixedMax ~= nil then hi = fixedMax end
				if hi - lo < 1e-9 then hi = lo + 1 end

				local step = niceStep(hi - lo, 5)
				if fixedMax == nil then
					hi = hi > 0 and (math.floor(hi / step + 1e-9) * step + step) or 0
				end
				if fixedMin == nil then
					lo = lo < 0 and (math.floor(lo / step + 1e-9) * step) or 0
				end
				if hi - lo < 1e-9 then hi = lo + step end
				return lo, hi
			end

			local function clearHover()
				if hoverIndex and bars[hoverIndex] then
					bars[hoverIndex].frame.BackgroundColor3 = bars[hoverIndex].color
				end
				hoverIndex = nil
				readout.Text = "Hover a bar"
				instantChartTooltip(hit)
			end

			local function setHover(index)
				if hoverIndex == index then
					return
				end
				if hoverIndex and bars[hoverIndex] then
					bars[hoverIndex].frame.BackgroundColor3 = bars[hoverIndex].color
				end
				hoverIndex = index

				if index and bars[index] then
					local b = bars[index]
					b.frame.BackgroundColor3 = b.color:Lerp(Color3.new(1, 1, 1), 0.28)
					readout.Text = b.item.Label .. ":  " .. fmt(b.item.Value)
					instantChartTooltip(hit, b.item.Label, "Value: " .. fmt(b.item.Value))
				else
					clearHover()
				end
			end

			local function redraw(animated)
				gridLayer:ClearAllChildren()
				barLayer:ClearAllChildren()
				tickLayer:ClearAllChildren()
				bars = {}
				clearHover()

				if #items == 0 then
					readout.Text = "No data"
					return
				end

				startIndex, endIndex = clampCategoricalRange(startIndex, endIndex, #items)
				local lo, hi = getRange()
				local range = math.max(1e-9, hi - lo)
				buildYGrid(gridLayer, tickLayer, PLOT_X, PLOT_Y, PW, PH, lo, hi)

				local visibleCount = endIndex - startIndex + 1
				slot = PW / visibleCount
				local barW = math.min(slot * 0.62, 56)
				local zeroY = PH - (0 - lo) / range * PH

				for i = startIndex, endIndex do
					local item = items[i]
					local cx = (i - startIndex + 0.5) * slot
					local y = PH - (item.Value - lo) / range * PH
					local top = math.min(y, zeroY)
					local height = math.max(1, math.abs(zeroY - y))
					local color = item.Color or PALETTE[(i - 1) % #PALETTE + 1]

					local frame = create("Frame", {
						BackgroundColor3 = color,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(cx - barW / 2, zeroY),
						Size = UDim2.fromOffset(barW, animated and 0 or height),
					}, barLayer)
					corner(frame, 3)

					if animated then
						tween(frame, {
							Position = UDim2.fromOffset(cx - barW / 2, top),
							Size = UDim2.fromOffset(barW, height),
						})
					else
						frame.Position = UDim2.fromOffset(cx - barW / 2, top)
					end

					bars[i] = { frame = frame, color = color, item = item }

					if showValues then
						local valueY = item.Value >= 0 and math.max(0, top - 15) or math.min(PH - 14, top + height + 1)
						local valueLabel = label(barLayer, fmt(item.Value), UDim2.fromOffset(cx - slot / 2, valueY), UDim2.fromOffset(slot, 14), Enum.Font.SourceSansSemibold, 12, Enum.TextXAlignment.Center)
						valueLabel.ZIndex = 4
					end

					local category = label(tickLayer, item.Label, UDim2.fromOffset(PLOT_X + cx - slot / 2 + 1, PLOT_Y + PH + 3), UDim2.fromOffset(math.max(1, slot - 2), 16), Enum.Font.SourceSans, 12, Enum.TextXAlignment.Center)
					category.TextColor3 = COLORS.SubText
				end
			end

			hit.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement then
					if #items == 0 then return end
					local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
					local visibleCount = endIndex - startIndex + 1
					local index = math.floor(startIndex + clamp01(rel.X / PW) * visibleCount)
					if rel.X < 0 or rel.X > PW then index = nil end
					setHover(index and index >= 1 and index <= #items and index or nil)
				elseif input.UserInputType == Enum.UserInputType.MouseWheel then
					if #items <= 1 then return end
					local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
					startIndex, endIndex = zoomCategoricalRange(startIndex, endIndex, #items, rel.X / PW, input.Position.Z > 0 and 0.76 or (1 / 0.76))
					redraw(false)
				end
			end)

			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 and #items > 1 then
					dragging = true
					dragX = UIS:GetMouseLocation().X
					dragStart, dragEnd = startIndex, endIndex
				end
			end)

			hit.MouseLeave:Connect(clearHover)

			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false
				end
			end)

			UIS.InputChanged:Connect(function(input)
				if dragging and input.UserInputType == Enum.UserInputType.MouseMovement and #items > 1 then
					local span = dragEnd - dragStart + 1
					local dx = UIS:GetMouseLocation().X - dragX
					local shift = math.floor(dx / PW * span + (dx >= 0 and 0.5 or -0.5))
					startIndex, endIndex = clampCategoricalRange(dragStart - shift, dragEnd - shift, #items)
					redraw(false)
				end
			end)

			d.onToggle = function(state)
				openBtn.Text = name .. (state and "  <" or "  >")
				tween(openBtn, { BackgroundColor3 = state and COLORS.Accent or COLORS.Widget })
				setChartSelected(openBtn, state)
				if state then
					resetView()
					redraw(true)
					if barHoverPoll then barHoverPoll:Disconnect() end
					barHoverPoll = RunService.RenderStepped:Connect(function()
						if not d.isOpen or #items == 0 then return end
						local rel=UIS:GetMouseLocation()-plot.AbsolutePosition
						if rel.X>=0 and rel.Y>=0 and rel.X<=PW and rel.Y<=PH then
							local visibleCount=endIndex-startIndex+1
							local idx=math.clamp(math.floor(startIndex+clamp01(rel.X/PW)*visibleCount),1,#items)
							setHover(idx)
						else
							setHover(nil)
						end
					end)
				else
					if barHoverPoll then barHoverPoll:Disconnect(); barHoverPoll=nil end
				end
			end

			openBtn.MouseButton1Click:Connect(function() d.setOpen(not d.isOpen) end)
			clearBtn.MouseButton1Click:Connect(function() chart:Clear() end)
			fitBtn.MouseButton1Click:Connect(function() resetView(); redraw(false) end)

			function chart:Set(data)
				items = normalizeItems(data)
				resetView()
				if d.isOpen then redraw(true) end
				return chart
			end

			function chart:Add(labelText, value, color)
				if type(value) ~= "number" then value = 0 end
				table.insert(items, { Label = tostring(labelText), Value = value, Color = color })
				if d.isOpen then redraw(true) end
				return chart
			end

			function chart:SetValue(labelText, value)
				labelText = tostring(labelText)
				if type(value) ~= "number" then value = 0 end
				for _, item in ipairs(items) do
					if item.Label == labelText then
						item.Value = value
						if d.isOpen then redraw(true) end
						return chart
					end
				end
				return chart:Add(labelText, value)
			end

			function chart:Remove(labelText)
			labelText = tostring(labelText)
			for i, item in ipairs(items) do
				if item.Label == labelText then
					table.remove(items, i)
					break
				end
			end
			resetView()
			if d.isOpen then redraw(true) end
			return chart
		end

		function chart:Clear()
			items = {}
			resetView()
			if d.isOpen then redraw(true) end
			return chart
		end

		function chart:Sort(descending)
			table.sort(items, function(a, b)
				if descending == false then return a.Value < b.Value end
				return a.Value > b.Value
			end)
			resetView()
			if d.isOpen then redraw(true) end
			return chart
		end

		function chart:SetRange(lo, hi)
			if type(lo) ~= "number" then lo = nil end
			if type(hi) ~= "number" then hi = nil end
			fixedMin, fixedMax = lo, hi
			if d.isOpen then redraw(false) end
			return chart
		end
		function chart:Get()
			local out = {}
			for _, it in ipairs(items) do out[#out + 1] = { Label = it.Label, Value = it.Value, Color = it.Color } end
			return out
		end
		function chart:GetValue(labelText)
			for _, it in ipairs(items) do
				if it.Label == tostring(labelText) then return it.Value end
			end
			return nil
		end

		function chart:SetTitle(t)
			d.title.Text = tostring(t)
			return chart
		end

		function chart:Open() d.setOpen(true) end
		function chart:Close() d.setOpen(false) end
		function chart:Toggle() d.setOpen(not d.isOpen) end
		function chart:IsOpen() return d.isOpen end

		return finalize(row, chart):SetTooltip({
			Header = "Bar Chart",
			Text = "Wheel = zoom\nDrag = pan\nHover a bar for its value\nFit = show all bars",
		})
		end

		-- Pie chart ------------------------------------------------------
		-- 3D block-built pie chart rendered inside a ViewportFrame. The
		-- original API stays the same (:Set, :Add, :SetValue, :Remove,
		-- :Clear, :Open, :Close, :Toggle, :IsOpen, :SetTitle).
		function Section:CreatePieChart(name, options)
			options = options or {}

			-- The chart remains visually tied to the original library:
			-- dark panel, red accent, compact legend, rounded corners.
			-- The actual pie is now a smooth-ish 3D extruded radial chart.
			local PANEL_W, PANEL_H = 410, 312
			local PIE_RADIUS = 4.25
			local PIE_HEIGHT = 0.62
			local PIE_TOP_Y = 0.60
			local ANGLE_STEP = 1.75
			local INNER_DONUT_RADIUS = 1.55
			local BORDER_THICKNESS = 0.12

			local items = normalizeItems(options.Data)
			local donut = false -- donut mode removed; pies are always full
			local chart = {}

			local row = newRow(name .. "PieChart")
			local openBtn = newButton(
				row,
				name .. "  >",
				UDim2.new(0.053, 0, 0, 3),
				UDim2.new(0, 153, 0, 24)
			)
			openBtn.Name = "Button"

			local d = dock(
				window,
				PANEL_W,
				PANEL_H,
				options.Title or name,
				safeName .. "PiePanel"
			)

			local rotateResetBtn = d.barButton(
				"Reset",
				PANEL_W - 134,
				46
			)

			local clearBtn = d.barButton(
				"Clear",
				PANEL_W - 30,
				46
			)

			-- The close button occupies the final 24px, so move Clear left.
			clearBtn.Position = UDim2.fromOffset(
				PANEL_W - 30 - 46 - 4,
				4
			)

			rotateResetBtn.Position = UDim2.fromOffset(
				PANEL_W - 30 - 46 - 4 - 50 - 4,
				4
			)

			local viewport = create("ViewportFrame", {
				Name = "PieViewport",
				Active = true,
				BackgroundColor3 = COLORS.Plot,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(10, 38),
				Size = UDim2.fromOffset(225, 225),
				ZIndex = 1,
			}, d.panel)

			corner(viewport, 6)

			create("UIStroke", {
				Color = COLORS.Stroke,
				Thickness = 1,
			}, viewport)

			local world = Instance.new("WorldModel")
			world.Name = "PieWorld"
			world.Parent = viewport

			local camera = Instance.new("Camera")
			camera.Name = "PieCamera"
			camera.FieldOfView = math.clamp(
				tonumber(options.FieldOfView) or 42,
				25,
				75
			)
			camera.Parent = viewport
			viewport.CurrentCamera = camera

			local labelLayer = create("Frame", {
				Name = "SliceLabels",
				Active = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.new(1, 0, 1, 0),
				ZIndex = 20,
			}, viewport)

			-- A transparent GUI input surface makes rotation/zoom reliable even
			-- when the ViewportFrame's internal 3D hit testing is busy.
			local pieInput = hoverCapture(viewport, 30)

			local readout = label(
				d.panel,
				"Hover a slice",
				UDim2.fromOffset(10, 268),
				UDim2.fromOffset(225, 18),
				Enum.Font.SourceSans,
				14,
				Enum.TextXAlignment.Center
			)
			readout.TextColor3 = COLORS.SubText

			local help = label(
				d.panel,
				"Wheel = zoom  |  Drag = rotate  |  Click = select",
				UDim2.fromOffset(10, 288),
				UDim2.fromOffset(225, 16),
				Enum.Font.SourceSans,
				12,
				Enum.TextXAlignment.Center
			)
			help.TextColor3 = COLORS.SubText

			local legend = create("ScrollingFrame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(244, 44),
				Size = UDim2.fromOffset(PANEL_W - 252, PANEL_H - 54),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ScrollBarThickness = 2,
			}, d.panel)

			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
			}, legend)

			local slices = {}
			local hoverIndex = nil
			local selected = {} -- set of selected slice indices (multi-select)
			local pieModel = nil

			local dragging = false
			local dragLast = nil
			local yaw = math.rad(14)
			local pitch = math.rad(55)
			local zoom = 1

			local autoRotate = options.AutoRotate == true
			local rotateSpeed = tonumber(options.RotateSpeed) or 0.45

			local hoverPollConn

			local function safeValue(value)
				if type(value) ~= "number" then
					return 0
				end

				if value ~= value
					or value == math.huge
					or value == -math.huge
				then
					return 0
				end

				return value
			end

			local function totalValue()
				local total = 0

				for _, item in ipairs(items) do
					total += math.max(
						0,
						safeValue(item.Value)
					)
				end

				return total
			end

			local function updateCamera()
				local distance = 11.9 / zoom
				local horizontal =
					math.cos(pitch)
					* distance

				local vertical =
					math.sin(pitch)
					* distance

				local position = Vector3.new(
					math.sin(yaw)
						* horizontal,
					vertical + 1.55,
					math.cos(yaw)
						* horizontal
				)

				camera.CFrame = CFrame.lookAt(
					position,
					Vector3.new(0, 0.22, 0)
				)
			end

			local function tweenPartCFrame(part, target)
				if not part
					or not part.Parent
				then
					return
				end

				pcall(function()
					TweenService:Create(
						part,
						TweenInfo.new(
							0.16,
							Enum.EasingStyle.Quart,
							Enum.EasingDirection.Out
						),
						{
							CFrame = target
						}
					):Play()
				end)
			end

			local function clearChartTooltip()
				instantChartTooltip(pieInput)
			end

			local function restoreSliceVisual(slice)
				if not slice then return end
				for _, info in ipairs(slice.parts or {}) do
					if info.part and info.part.Parent then
						info.part.Color = slice.color
						tweenPartCFrame(info.part, info.rest)
						if info.size then
							tween(info.part, { Size = info.size })
						end
					end
					if info.glow and info.glow.Parent then
						info.glow.Transparency = 1
						tweenPartCFrame(info.glow, info.glowRest or info.rest)
						if info.glowSize then
							tween(info.glow, { Size = info.glowSize })
						end
					end
				end
				if slice.row then tween(slice.row,{BackgroundTransparency=1}) end
			end

			-- heightScale > 1 makes the slice visibly grow (taller) rather
			-- than only nudging it outward, so a hovered slice reads clearly
			-- as "bigger", and glowTransparency near 0 gives a strong neon rim.
			local function applySliceVisual(slice, offsetAmount, glowTransparency, heightScale)
				if not slice then return end
				heightScale = heightScale or 1
				local mid = math.rad((slice.a0 + slice.a1) * 0.5)
				local offset = Vector3.new(math.cos(mid),0,math.sin(mid)) * (offsetAmount or 0.34)
				local highlighted = slice.color:Lerp(Color3.new(1,1,1),0.18)
				for _, info in ipairs(slice.parts or {}) do
					if info.part and info.part.Parent then
						info.part.Color = highlighted
						tweenPartCFrame(info.part, CFrame.new(offset) * info.rest)
						if info.size then
							tween(info.part, { Size = Vector3.new(info.size.X, info.size.Y * heightScale, info.size.Z) })
						end
					end
					if info.glow and info.glow.Parent then
						info.glow.Color = highlighted
						info.glow.Transparency = glowTransparency or 0.52
						tweenPartCFrame(info.glow, CFrame.new(offset) * (info.glowRest or info.rest) * CFrame.new(0,0.06,0))
						if info.glowSize then
							tween(info.glow, { Size = Vector3.new(info.glowSize.X, info.glowSize.Y * heightScale, info.glowSize.Z) })
						end
					end
				end
				if slice.row then tween(slice.row,{BackgroundTransparency=0.12}) end
			end

			local function selectionText()
				local n, v, pct = 0, 0, 0
				local only
				for i, sl in ipairs(slices) do
					if selected[i] then
						n += 1
						v += sl.item.Value
						pct += sl.pct
						only = sl
					end
				end
				if n == 0 then return nil end
				if n == 1 then
					return string.format("%s: %s  (%.1f%%)", only.item.Label, fmt(only.item.Value), only.pct)
				end
				return string.format("%d selected: %s  (%.1f%%)", n, fmt(v), pct)
			end

			local function reapplySelected(skip)
				for i, sl in ipairs(slices) do
					if selected[i] and i ~= skip then
						applySliceVisual(sl, 0.30, 0.20, 1.15)
					end
				end
			end

			local function restoreHover()
				if hoverIndex and slices[hoverIndex] then
					restoreSliceVisual(slices[hoverIndex])
				end
				hoverIndex = nil
				reapplySelected()
				readout.Text = selectionText() or "Hover a slice"
				clearChartTooltip()
			end

			local function setHover(index)
				if index == hoverIndex then return end
				if hoverIndex and slices[hoverIndex] then restoreSliceVisual(slices[hoverIndex]) end
				hoverIndex = index
				local slice = index and slices[index] or nil
				if not slice then
					reapplySelected()
					readout.Text = selectionText() or "Hover a slice"
					clearChartTooltip()
					return
				end
				-- a hovered slice always grows and glows strongly, selected or not
				reapplySelected(index)
				applySliceVisual(slice, 0.36, 0.14, 1.4)
				readout.Text = string.format("%s: %s  (%.1f%%)", slice.item.Label, fmt(slice.item.Value), slice.pct)
				instantChartTooltip(pieInput, slice.item.Label, "Value: " .. fmt(slice.item.Value) .. "\n" .. string.format("%.1f%% of total", slice.pct), "pie:" .. tostring(slice.index))
			end

			-- clicking a slice toggles it; any number of slices can be selected
			local function toggleSelected(index)
				if not index or not slices[index] then return end
				if selected[index] then
					selected[index] = nil
					restoreSliceVisual(slices[index])
				else
					selected[index] = true
					applySliceVisual(slices[index], 0.30, 0.20, 1.15)
				end
				local h = hoverIndex
				hoverIndex = nil
				setHover(h)
			end

			local function clearSelection()
				for i, sl in pairs(slices) do
					if selected[i] then restoreSliceVisual(sl) end
				end
				selected = {}
				local h = hoverIndex
				hoverIndex = nil
				setHover(h)
			end

			local function clearWorld()
				for _, child in ipairs(
					world:GetChildren()
				) do
					child:Destroy()
				end

				pieModel = nil
				slices = {}
				hoverIndex = nil
				selected = {}

				for _, child in ipairs(
					labelLayer:GetChildren()
				) do
					child:Destroy()
				end
			end

			local function createCylinder(
				nameText,
				radius,
				height,
				y,
				color,
				material,
				parent
			)
				local part = Instance.new(
					"Part"
				)

				part.Name = nameText
				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.CastShadow = false
				part.Shape = Enum.PartType.Cylinder
				part.Material =
					material
					or Enum.Material.SmoothPlastic
				part.Color = color
				part.Size = Vector3.new(
					radius * 2,
					height,
					radius * 2
				)
				part.CFrame = CFrame.new(
					0,
					y,
					0
				)
				part.Parent = parent

				return part
			end

			local function makeSeparator(
				angleDegrees,
				innerRadius,
				outerRadius
			)
				local mid =
					math.rad(
						angleDegrees
					)

				local length =
					math.max(
						0.02,
						outerRadius
							- innerRadius
					)

				local radialCenter =
					innerRadius
					+ length * 0.5

				local part =
					Instance.new(
						"Part"
					)

				part.Name =
					"SliceSeparator"

				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.CastShadow = false
				part.Material =
					Enum.Material.SmoothPlastic
				part.Color =
					Color3.fromRGB(
						12,
						12,
						12
					)

				part.Size = Vector3.new(
					BORDER_THICKNESS,
					PIE_HEIGHT
						+ 0.04,
					length
				)

				part.CFrame =
					CFrame.new(
						math.cos(mid)
							* radialCenter,
						0.39,
						math.sin(mid)
							* radialCenter
					)
					* CFrame.Angles(
						0,
						math.rad(90)
							- mid,
						0
					)

				part.Parent = pieModel
			end

			local function redraw(animated)
				restoreHover()
				selected = {}
				clearWorld()

				for _, child in ipairs(
					legend:GetChildren()
				) do
					if child:IsA("Frame") then
						child:Destroy()
					end
				end

				local total = totalValue()

				if total <= 0 then
					readout.Text =
						"No data"

					createCylinder(
						"EmptyPie",
						PIE_RADIUS,
						PIE_HEIGHT,
						0.39,
						COLORS.Widget,
						Enum.Material.SmoothPlastic,
						world
					)

					updateCamera()
					return
				end

				pieModel =
					Instance.new(
						"Model"
					)

				pieModel.Name =
					"Pie"

				pieModel.Parent =
					world

				local outer = PIE_RADIUS
				local inner =
					donut
					and INNER_DONUT_RADIUS
					or 0

				local angle = 0

				for i, item in ipairs(
					items
				) do
					local value =
						math.max(
							0,
							safeValue(
								item.Value
							)
						)

					if value > 0 then
						local a0 = angle
						local a1 =
							angle
							+ value
								/ total
								* 360

						angle = a1

						local color =
							item.Color
							or PALETTE[
								(i - 1)
									% #PALETTE
									+ 1
							]

						local parts = {}
						local a = a0

						while a < a1 - 1e-5 do
							local stepDeg =
								math.min(
									ANGLE_STEP,
									a1 - a
								)

							local mid =
								math.rad(
									a
										+ stepDeg
											* 0.5
								)

							local stepRad =
								math.rad(
									stepDeg
								)

							local radialLength =
								math.max(
									0.02,
									outer
										- inner
								)

							-- Chord width gives a much smoother circular
							-- outside edge than the old rectangular bars.
							local tangentWidth =
								math.max(
									0.035,
									2
										* outer
										* math.sin(
											stepRad
												/ 2
										)
										* 1.03
								)

							local radialCenter =
								inner
									+ radialLength
										* 0.5

							local basePosition =
								Vector3.new(
									math.cos(mid)
										* radialCenter,
									0.39,
									math.sin(mid)
										* radialCenter
								)

							local rest =
								CFrame.new(
									basePosition
								)
								* CFrame.Angles(
									0,
									math.rad(90)
										- mid,
									0
								)

							local part =
								Instance.new(
									"Part"
								)

							part.Name =
								"PieSlicePart"

							part.Anchored =
								true

							part.CanCollide =
								false

							part.CanTouch =
								false

							part.CanQuery =
								true

							part.CastShadow =
								false

							part.Material =
								Enum.Material.SmoothPlastic

							part.Color =
								color

							part.Size =
								Vector3.new(
									tangentWidth,
									animated
										and 0.04
										or PIE_HEIGHT,
									radialLength
								)

							part.CFrame =
								animated
								and (
									CFrame.new(
										basePosition
											- Vector3.new(
												0,
												(
													PIE_HEIGHT
														- 0.04
												)
													* 0.5,
												0
											)
									)
									* CFrame.Angles(
										0,
										math.rad(90)
											- mid,
										0
									)
								)
								or rest

							part.Parent =
								pieModel

							local glow = Instance.new("Part")
							glow.Name = "PieGlow"
							glow.Anchored = true
							glow.CanCollide = false
							glow.CanTouch = false
							glow.CanQuery = false
							glow.CastShadow = false
							glow.Material = Enum.Material.Neon
							glow.Color = color:Lerp(Color3.new(1,1,1),0.2)
							glow.Transparency = 1
							glow.Size = Vector3.new(tangentWidth + 0.08, PIE_HEIGHT + 0.08, radialLength + 0.08)
							glow.CFrame = rest * CFrame.new(0,0.045,0)
							glow.Parent = pieModel

							parts[#parts + 1] = {
								part = part,
								rest = rest,
								glow = glow,
								size = Vector3.new(tangentWidth, PIE_HEIGHT, radialLength),
								glowSize = Vector3.new(tangentWidth + 0.08, PIE_HEIGHT + 0.08, radialLength + 0.08),
							}

							if animated then
								pcall(function()
									TweenService:Create(
										part,
										TweenInfo.new(
											0.26,
											Enum.EasingStyle.Quart,
											Enum.EasingDirection.Out
										),
										{
											Size = Vector3.new(
												tangentWidth,
												PIE_HEIGHT,
												radialLength
											),
											CFrame = rest,
										}
									):Play()
								end)
							end

							a += stepDeg
						end

						slices[
							#slices + 1
						] = {
							item = item,
							color = color,
							a0 = a0,
							a1 = a1,
							pct =
								value
								/ total
								* 100,
							parts = parts,
							index =
								#slices + 1,
						}
					end
				end

				-- Raised boundary lines make slice separation crisp.
				if #slices > 1 then
					for _, slice in ipairs(
						slices
					) do
						makeSeparator(
							slice.a0,
							inner,
							outer
						)
					end
				end

				-- Donut hole: this is an actual 3D cylinder placed over
				-- the segmented ring, rather than a fake UI circle.
				if donut then
					createCylinder(
						"DonutHole",
						inner * 0.995,
						PIE_HEIGHT
							+ 0.12,
						0.40,
						Color3.fromRGB(
							18,
							18,
							18
						),
						Enum.Material.SmoothPlastic,
						pieModel
					)
				end

				-- Legend: still compact and in the original design language.
				for i, slice in ipairs(
					slices
				) do
					local itemRow =
						create(
							"Frame",
							{
								LayoutOrder = i,
								BackgroundColor3 =
									COLORS.Widget,
								BackgroundTransparency = 1,
								BorderSizePixel = 0,
								Size = UDim2.fromOffset(
									PANEL_W
										- 266,
									34
								),
							},
							legend
						)

					corner(
						itemRow,
						5
					)

					local swatch =
						create(
							"Frame",
							{
								BackgroundColor3 =
									slice.color,
								BorderSizePixel = 0,
								Position =
									UDim2.fromOffset(
										7,
										11
									),
								Size =
									UDim2.fromOffset(
										10,
										10
									),
							},
							itemRow
						)

					corner(
						swatch,
						5
					)

					label(
						itemRow,
						slice.item.Label,
						UDim2.fromOffset(
							23,
							2
						),
						UDim2.fromOffset(
							104,
							15
						),
						Enum.Font.SourceSansSemibold,
						13
					)

					local valueLabel =
						label(
							itemRow,
							fmt(
								slice.item.Value
							),
							UDim2.fromOffset(
								23,
								17
							),
							UDim2.fromOffset(
								76,
								13
							),
							Enum.Font.SourceSans,
							12
						)

					valueLabel.TextColor3 =
						COLORS.SubText

					local pct =
						label(
							itemRow,
							string.format(
								"%.1f%%",
								slice.pct
							),
							UDim2.new(
								1,
								-64,
								0,
								7
							),
							UDim2.fromOffset(
								58,
								18
							),
							Enum.Font.SourceSansSemibold,
							12,
							Enum.TextXAlignment.Right
						)

					pct.TextColor3 =
						COLORS.SubText

					slice.row =
						itemRow

					local rowClick = create("TextButton", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 1, 0),
						Text = "",
						ZIndex = 5,
					}, itemRow)
					rowClick.MouseButton1Click:Connect(function()
						toggleSelected(i)
					end)

					itemRow.MouseEnter:Connect(
						function()
							setHover(i)
						end
					)

					itemRow.MouseLeave:Connect(
						function()
							if hoverIndex == i then
								setHover(nil)
							end
						end
					)
				end

				updateCamera()
			end

			local function updateLabels()
				if not d.isOpen then
					return
				end

				for i, slice in ipairs(
					slices
				) do
					local labelObject =
						labelLayer:FindFirstChild(
							"Label_" .. i
						)

					if labelObject then
						local mid =
							math.rad(
								(slice.a0
									+ slice.a1)
									* 0.5
							)

						local labelRadius =
							(
								donut
								and (
									INNER_DONUT_RADIUS
										+ PIE_RADIUS
								) * 0.5
								or PIE_RADIUS
									* 0.57
							)

						local worldPosition =
							Vector3.new(
								math.cos(mid)
									* labelRadius,
								PIE_TOP_Y
									+ 0.05,
								math.sin(mid)
									* labelRadius
							)

						local ok, viewportPoint =
							pcall(
								function()
									return camera:WorldToViewportPoint(
										worldPosition
									)
								end
							)

						if ok
							and viewportPoint
						then
							local visible =
								viewportPoint.Z
									> 0

							labelObject.Visible =
								visible

							if visible then
								local w =
									labelObject.AbsoluteSize.X

								local h =
									labelObject.AbsoluteSize.Y

								labelObject.Position =
									UDim2.fromOffset(
										viewportPoint.X
											- w * 0.5,
										viewportPoint.Y
											- h * 0.5
									)
							end
						end
					end
				end
			end

			local function rebuildSliceLabels()
				for _, child in ipairs(
					labelLayer:GetChildren()
				) do
					child:Destroy()
				end

				for i, slice in ipairs(
					slices
				) do
					-- Avoid unreadable tiny labels; hover/legend still
					-- exposes those slices.
					if slice.pct >= 7 then
						local textLabel =
							create(
								"TextLabel",
								{
									Name =
										"Label_" .. i,
									Active = false,
									AnchorPoint =
										Vector2.new(
											0.5,
											0.5
										),
									BackgroundTransparency = 1,
									Font =
										Enum.Font.SourceSansBold,
									RichText = true,
									Text =
										slice.item.Label
										.. "\n"
										.. string.format(
											"<b>%.1f%%</b>",
											slice.pct
										),
									TextColor3 =
										Color3.new(
											1,
											1,
											1
										),
									TextSize = 16,
									TextStrokeColor3 =
										Color3.new(
											0,
											0,
											0
										),
									TextStrokeTransparency =
										0.25,
									TextWrapped = true,
									Size =
										UDim2.fromOffset(
											86,
											44
										),
									TextXAlignment =
										Enum.TextXAlignment.Center,
									TextYAlignment =
										Enum.TextYAlignment.Center,
									ZIndex = 21,
								},
								labelLayer
							)

						textLabel:SetAttribute(
							"SliceIndex",
							i
						)
					end
				end

				updateLabels()
			end

			local function geometricSlice(ray)
				if not ray
					or #slices == 0
				then
					return nil
				end

				local dy =
					ray.Direction.Y

				if math.abs(dy)
					< 1e-6
				then
					return nil
				end

				local t =
					(PIE_TOP_Y
						- ray.Origin.Y)
					/ dy

				if t <= 0 then
					return nil
				end

				local point =
					ray.Origin
					+ ray.Direction
						* t

				local radius =
					math.sqrt(
						point.X
							* point.X
							+ point.Z
								* point.Z
					)

				local inner =
					donut
					and INNER_DONUT_RADIUS
					or 0

				if radius > PIE_RADIUS
					or radius < inner
				then
					return nil
				end

				local angle =
					(
						math.deg(
							math.atan2(
								point.Z,
								point.X
							)
						)
						% 360
						+ 360
					)
					% 360

				for index, slice in ipairs(
					slices
				) do
					if angle >= slice.a0
						and angle < slice.a1
					then
						return index
					end
				end

				-- Exact 360° edge case.
				if angle >= 359.999 then
					return #slices
				end

				return nil
			end

			local function raycastSlice()
				if not d.isOpen
					or not pieModel
				then
					return nil
				end

				local mouse =
					UIS:GetMouseLocation()

				local localPos =
					mouse
					- viewport.AbsolutePosition

				if localPos.X < 0
					or localPos.Y < 0
					or localPos.X
						> viewport.AbsoluteSize.X
					or localPos.Y
						> viewport.AbsoluteSize.Y
				then
					return nil
				end

				local okRay, ray =
					pcall(
						function()
							return camera:ViewportPointToRay(
								localPos.X,
								localPos.Y
							)
						end
					)

				if okRay
					and ray
				then
					local params =
						RaycastParams.new()

					params.FilterType =
						Enum.RaycastFilterType.Include

					params.FilterDescendantsInstances =
						{
							pieModel
						}

					params.IgnoreWater =
						true

					local okCast, result =
						pcall(
							function()
								return world:Raycast(
									ray.Origin,
									ray.Direction
										* 1000,
									params
								)
							end
						)

					if okCast
						and result
						and result.Instance
					then
						for index, slice in ipairs(
							slices
						) do
							for _, info in ipairs(
								slice.parts
							) do
								if info.part == result.Instance
									or info.glow == result.Instance
								then
									return index
								end
							end
						end
					end

					return geometricSlice(
						ray
					)
				end

				return nil
			end

			local function updateHoverFromMouse()
				if not d.isOpen then return end
				local mouse = UIS:GetMouseLocation()
				local rel = mouse - viewport.AbsolutePosition
				if rel.X < 0 or rel.Y < 0 or rel.X > viewport.AbsoluteSize.X or rel.Y > viewport.AbsoluteSize.Y then
					if hoverIndex then restoreHover() end
					return
				end
				local hitIndex = raycastSlice()
				if hitIndex then setHover(hitIndex) elseif hoverIndex then restoreHover() end
			end

			local function stopHoverPolling()
				if hoverPollConn then
					hoverPollConn:Disconnect()
					hoverPollConn = nil
				end

			end

			pieInput.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseWheel then
					local factor = input.Position.Z > 0 and 0.84 or (1 / 0.84)
					zoom = math.clamp(zoom * factor, 0.62, 1.65)
					updateCamera()
					updateHoverFromMouse()
				end
			end)

			local dragDistance = 0
			local CLICK_DRAG_THRESHOLD = 6

			pieInput.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					dragDistance = 0
					dragLast = Vector2.new(input.Position.X,input.Position.Y)
				end
			end)

			-- Belt-and-suspenders: the button's own native click event fires
			-- on a clean press+release with no custom drag-distance math
			-- involved, so selection isn't at the mercy of that heuristic.

			pieInput.MouseLeave:Connect(function()
				if hoverIndex then restoreHover() else clearChartTooltip() end
			end)

			UIS.InputEnded:Connect(
				function(input)
					if input.UserInputType
						== Enum.UserInputType.MouseButton1
						or input.UserInputType
							== Enum.UserInputType.Touch
					then
						if dragging and dragDistance < CLICK_DRAG_THRESHOLD then
							toggleSelected(raycastSlice())
						end
						dragging = false
						dragLast = nil
						dragDistance = 0
					end
				end
			)

			UIS.InputChanged:Connect(
				function(input)
					if not dragging
						or (
							input.UserInputType
								~= Enum.UserInputType.MouseMovement
							and input.UserInputType
								~= Enum.UserInputType.Touch
						)
					then
						return
					end

					local current =
						Vector2.new(
							input.Position.X,
							input.Position.Y
						)

					if dragLast then
						local delta =
							current
							- dragLast

						dragDistance = dragDistance + delta.Magnitude

						yaw -=
							delta.X
							* 0.008

						pitch =
							math.clamp(
								pitch
									- delta.Y
										* 0.006,
								math.rad(22),
								math.rad(70)
							)

						updateCamera()
						updateHoverFromMouse()
					end

					dragLast =
						current
				end
			)

			rotateResetBtn.MouseButton1Click:Connect(
				function()
					yaw = math.rad(14)
					pitch = math.rad(55)
					zoom = 1
					clearSelection()

					updateCamera()
					updateHoverFromMouse()
				end
			)

			d.onToggle = function(state)
				openBtn.Text =
					name
					.. (
						state
							and "  <"
							or "  >"
					)

				tween(openBtn, {
					BackgroundColor3 =
						state
							and COLORS.Accent
							or COLORS.Widget
				})

				if state then
					animatePanelIn(
						d.panel
					)

					redraw(true)
					rebuildSliceLabels()

					stopHoverPolling()

					hoverPollConn =
						RunService.RenderStepped:Connect(
							function(dt)
								if not d.isOpen then
									return
								end

								if autoRotate
									and not dragging
								then
									yaw +=
										dt * rotateSpeed
									updateCamera()
								end

								updateHoverFromMouse()
								updateLabels()
							end
						)

					updateHoverFromMouse()
				else
					stopHoverPolling()
					clearChartTooltip()
				end
			end

			openBtn.MouseButton1Click:Connect(
				function()
					d.setOpen(
						not d.isOpen
					)
				end
			)

			clearBtn.MouseButton1Click:Connect(
				function()
					chart:Clear()
				end
			)

			function chart:Set(data)
				items =
					normalizeItems(data)

				if d.isOpen then
					redraw(true)
					rebuildSliceLabels()
					updateHoverFromMouse()
				end

				return chart
			end

			function chart:Add(
				labelText,
				value,
				color
			)
				if type(value)
					~= "number"
					or value ~= value
					or value == math.huge
					or value == -math.huge
				then
					value = 0
				end

				table.insert(
					items,
					{
						Label =
							tostring(
								labelText
							),
						Value = value,
						Color = color,
					}
				)

				if d.isOpen then
					redraw(true)
					rebuildSliceLabels()
					updateHoverFromMouse()
				end

				return chart
			end

			function chart:SetValue(
				labelText,
				value
			)
				labelText =
					tostring(
						labelText
					)

				if type(value)
					~= "number"
					or value ~= value
					or value == math.huge
					or value == -math.huge
				then
					value = 0
				end

				for _, item in ipairs(
					items
				) do
					if item.Label
						== labelText
					then
						item.Value =
							value

						if d.isOpen then
							redraw(true)
							rebuildSliceLabels()
							updateHoverFromMouse()
						end

						return chart
					end
				end

				return chart:Add(
					labelText,
					value
				)
			end

			function chart:Remove(
				labelText
			)
				labelText =
					tostring(
						labelText
					)

				for i, item in ipairs(
					items
				) do
					if item.Label
						== labelText
					then
						table.remove(
							items,
							i
						)
						break
					end
				end

				if d.isOpen then
					redraw(true)
					rebuildSliceLabels()
					updateHoverFromMouse()
				end

				return chart
			end

			function chart:Clear()
				items = {}

				if d.isOpen then
					redraw(true)
					rebuildSliceLabels()
				end

				return chart
			end

			function chart:GetSelected()
				local out = {}
				for i, sl in ipairs(slices) do
					if selected[i] then
						out[#out + 1] = { Label = sl.item.Label, Value = sl.item.Value, Percent = sl.pct }
					end
				end
				return out
			end
			function chart:SetSelected(list)
				clearSelection()
				for _, want in ipairs(list or {}) do
					for i, sl in ipairs(slices) do
						if sl.item.Label == tostring(want) and not selected[i] then
							selected[i] = true
							applySliceVisual(sl, 0.30, 0.20, 1.15)
						end
					end
				end
				readout.Text = selectionText() or "Hover a slice"
				return chart
			end
			function chart:ClearSelection() clearSelection(); return chart end
			function chart:Get()
				local out = {}
				for _, it in ipairs(items) do out[#out + 1] = { Label = it.Label, Value = it.Value, Color = it.Color } end
				return out
			end

			function chart:SetAutoRotate(state)
				autoRotate =
					state
					and true
					or false

				return chart
			end

			function chart:SetRotateSpeed(speed)
				if type(speed)
					== "number"
				then
					rotateSpeed =
						math.clamp(
							speed,
							0,
							8
						)
				end

				return chart
			end

			function chart:ResetRotation()
				yaw = math.rad(18)
				pitch = math.rad(36)
				zoom = 1
				updateCamera()
				updateHoverFromMouse()
				return chart
			end

			function chart:SetTitle(t)
				d.title.Text =
					tostring(t)

				return chart
			end

			function chart:Open()
				d.setOpen(true)
			end

			function chart:Close()
				d.setOpen(false)
			end

			function chart:Toggle()
				d.setOpen(
					not d.isOpen
				)
			end

			function chart:IsOpen()
				return d.isOpen
			end

			return finalize(
				row,
				chart
			):SetTooltip({
				Header = "Pie Chart",
				Text = "Hover for 1s for slice details\n"
					.. "Wheel = zoom\n"
					.. "Drag = rotate\n"
					.. "Click = select / deselect slices\n"
					.. "Reset = deselect all + restore the camera",
			})
		end

		-- Line graph (labelled categories on x, one or more series) -------
		function Section:CreateLineGraph(name, options)
			options = options or {}
			local PANEL_W, PANEL_H = 380, 340
			local PLOT_X, PLOT_Y, PW, PH = 46, 38, 324, 170
			local MARGIN = 18

			local labels = {}
			for i, v in ipairs(options.Labels or {}) do labels[i] = tostring(v) end
			local fixedMin, fixedMax = options.YMin, options.YMax
			local series, order, paletteIndex = {}, {}, 0
			local rainbowMode, rainbowShift = false, 0
			local chart = {}
			local lineHoverPoll
			local hoverPoll

			local row = newRow(name .. "LineGraph")
			local openBtn = newButton(row, name .. "  >", UDim2.new(0.053, 0, 0, 3), UDim2.new(0, 153, 0, 24))
			openBtn.Name = "Button"

			local d = dock(window, PANEL_W, PANEL_H, options.Title or name, safeName .. "LinePanel")
			local fitBtn = d.barButton("Fit", PANEL_W - 128, 40)
			local clearBtn = d.barButton("Clear", PANEL_W - 82, 46)
			local rainbowBtn = d.barButton("Rainbow", PANEL_W - 190, 58)
			d.title.Size = UDim2.fromOffset(PANEL_W - 198, ROW)

			local plot = create("Frame", {
				BackgroundColor3 = COLORS.Plot,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(PLOT_X, PLOT_Y),
				Size = UDim2.fromOffset(PW, PH),
			}, d.panel)
			create("UIStroke", { Color = COLORS.Stroke, Thickness = 1 }, plot)

			local gridLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 1 }, plot)
			local lineLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2 }, plot)
			local hoverLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 8 }, plot)
			local hit = hoverCapture(plot, 12)
			local tickLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0) }, d.panel)

			local readout = label(d.panel, "Hover the graph", UDim2.fromOffset(PLOT_X, PLOT_Y + PH + 22), UDim2.fromOffset(PW, 16), Enum.Font.SourceSans, 14)
			readout.TextColor3 = COLORS.SubText

			local legend = create("ScrollingFrame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(8, PLOT_Y + PH + 44),
				Size = UDim2.fromOffset(PANEL_W - 16, 28),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				ScrollingDirection = Enum.ScrollingDirection.X,
				ScrollBarThickness = 2,
			}, d.panel)
			create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, legend)

			local activeId

			-- Scrubber: a draggable timeline below the legend to scrub to any index.
			local SCRUB_Y = PLOT_Y + PH + 44 + 28 + 10
			local scrubTrack = create("Frame", {
				Name = "ScrubTrack",
				Active = true,
				BackgroundColor3 = COLORS.Raised,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(PLOT_X, SCRUB_Y),
				Size = UDim2.fromOffset(PW, 4),
			}, d.panel)
			corner(scrubTrack, 2)

			local scrubFill = create("Frame", {
				Name = "ScrubFill",
				BackgroundColor3 = COLORS.Accent,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(0, 4),
			}, scrubTrack)
			corner(scrubFill, 2)

			local scrubHandle = create("Frame", {
				Name = "ScrubHandle",
				Active = true,
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = COLORS.Text,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 2),
				Size = UDim2.fromOffset(12, 12),
				ZIndex = 5,
			}, scrubTrack)
			corner(scrubHandle, 6)
			create("UIStroke", { Color = COLORS.Accent, Thickness = 1 }, scrubHandle)

			local viewStart, viewEnd = 1, math.max(1, #labels)
			local viewLo, viewHi = 0, 1
			local dragging, dragX, dragStart, dragEnd = false, 0, 1, 1

			local function count()
				local n = #labels
				for _, id in ipairs(order) do
					local s = series[id]
					if s then n = math.max(n, #s.Values) end
				end
				return n
			end

			local function resetView()
				local n = count()
				viewStart, viewEnd = 1, math.max(1, n)
			end

			local function xAt(index, n)
				if n <= 1 then return PW / 2 end
				local span = math.max(1, viewEnd - viewStart)
				return MARGIN + ((index - viewStart) / span) * (PW - 2 * MARGIN)
			end

			local function ensure(id, color)
				if not series[id] then
					paletteIndex += 1
					series[id] = {
						Name = tostring(id),
						Color = color or PALETTE[(paletteIndex - 1) % #PALETTE + 1],
						Values = {},
						Ranges = {},
						PointColors = {},
						Rainbow = false,
					}
					table.insert(order, id)
				elseif color then
					series[id].Color = color
				end
				return series[id]
			end

			-- Per-point/range colours; range sequences are sampled for dots and rendered as UIGradients on the line.
			local function rainbowAt(i, n)
				return Color3.fromHSV((((i - 1) / math.max(1, n - 1)) * 0.85 + rainbowShift) % 1, 0.72, 1)
			end
			local function sampleSequence(sequence, alpha)
				alpha = clamp01(alpha)
				local keys = sequence.Keypoints
				if alpha <= keys[1].Time then return keys[1].Value end
				for keyIndex = 1, #keys - 1 do
					local left, right = keys[keyIndex], keys[keyIndex + 1]
					if alpha <= right.Time then
						return left.Value:Lerp(right.Value, (alpha - left.Time) / math.max(1e-6, right.Time - left.Time))
					end
				end
				return keys[#keys].Value
			end
			local function pointColor(s, i)
			if rainbowMode then return rainbowAt(i, count()) end
			if s.PointColors[i] then return s.PointColors[i] end
				local c = s.Color
				if s.Rainbow then c = rainbowAt(i, count()) end
				for _, r in ipairs(s.Ranges) do
					if i >= r.from and i <= r.to then
						if typeof(r.color) == "ColorSequence" then
							c = sampleSequence(r.color, (i - r.from) / math.max(1, r.to - r.from))
						else
							c = r.color
						end
					end
				end
				return c
			end
			local function segColor(s, a, b)
				local startColor, endColor = pointColor(s, a), pointColor(s, b)
				if not sameColor(startColor, endColor) then return ColorSequence.new(startColor, endColor) end
				return startColor
			end
			-- the distinct colours a series is drawn in, in order: base first, then ranges/points
			local function seriesColors(s)
				local list, seen = {}, {}
				local function add(c)
					local key = string.format("%.3f,%.3f,%.3f", c.R, c.G, c.B)
					if not seen[key] then seen[key] = true; list[#list + 1] = c end
				end
				local n = math.max(#s.Values, 1)
				local usesBase = false
				for i = 1, n do
					local covered = s.PointColors[i] ~= nil
					for _, r in ipairs(s.Ranges) do
						if i >= r.from and i <= r.to then covered = true end
					end
					if not covered then usesBase = true break end
				end
				if usesBase then add(s.Color) end
				for _, r in ipairs(s.Ranges) do
					if typeof(r.color) == "ColorSequence" then
						for _, keypoint in ipairs(r.color.Keypoints) do add(keypoint.Value) end
					else
						add(r.color)
					end
				end
				for _, c in pairs(s.PointColors) do add(c) end
				if #list == 0 then add(s.Color) end
				return list
			end

			local redraw
			local function rebuildLegend()
				if not activeId or not series[activeId] then activeId = order[#order] end
				local entries = {}
				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						local gradient
						if s.Rainbow or rainbowMode then
						gradient = LEGEND_RAINBOW_SEQ
						else
							local n = math.max(#s.Values, 1)
							local sampled = {}
							local sampleCount = math.min(10, n)
							for sampleIndex = 1, sampleCount do
								local sourceIndex = sampleCount == 1 and 1 or math.floor(1 + (sampleIndex - 1) * (n - 1) / (sampleCount - 1) + 0.5)
								sampled[#sampled + 1] = pointColor(s, sourceIndex)
							end
							local hasMultipleColors = false
							for index = 2, #sampled do
								if not sameColor(sampled[index], sampled[1]) then hasMultipleColors = true break end
							end
							if hasMultipleColors then
								local keys = {}
								for index, col in ipairs(sampled) do
									keys[#keys + 1] = ColorSequenceKeypoint.new((index - 1) / (#sampled - 1), col)
								end
								gradient = ColorSequence.new(keys)
							end
						end
						entries[#entries + 1] = { id = id, name = s.Name, color = s.Color, colors = seriesColors(s), rainbow = s.Rainbow or rainbowMode, gradient = gradient }
					end
				end
				buildChips(legend, entries, function(id) chart:RemoveSeries(id) end, function(id)
					activeId = id
					rebuildLegend()
					if d.isOpen and redraw then redraw(false) end
				end, activeId)
			end

			redraw = function(animated)
				gridLayer:ClearAllChildren()
				lineLayer:ClearAllChildren()
				hoverLayer:ClearAllChildren()
				tickLayer:ClearAllChildren()

				local n = count()
				if n <= 0 then
					viewLo, viewHi = 0, 1
					readout.Text = "No data"
					return
				end

				viewStart, viewEnd = clampCategoricalRange(viewStart, viewEnd, n)
				local lo, hi = math.huge, -math.huge
				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						for _, value in ipairs(s.Values) do
							if type(value) == "number" then
								lo, hi = math.min(lo, value), math.max(hi, value)
							end
						end
					end
				end

				if lo == math.huge then lo, hi = 0, 1 end
				if lo > 0 then lo = 0 end
				if fixedMin ~= nil then lo = fixedMin end
				if fixedMax ~= nil then hi = fixedMax end
				if hi - lo < 1e-9 then hi = lo + 1 end

				local step = niceStep(hi - lo, 5)
				if fixedMax == nil then hi = math.floor(hi / step + 1e-9) * step + step end
				if fixedMin == nil then lo = math.floor(lo / step + 1e-9) * step end
				viewLo, viewHi = lo, hi

				buildYGrid(gridLayer, tickLayer, PLOT_X, PLOT_Y, PW, PH, lo, hi)

				local visibleCount = viewEnd - viewStart + 1
				local labelStride = math.max(1, math.ceil(visibleCount / 9))
				for i = viewStart, viewEnd, labelStride do
					local x = xAt(i, n)
					create("Frame", {
						BackgroundColor3 = COLORS.Grid,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(x, 0),
						Size = UDim2.fromOffset(1, PH),
					}, gridLayer)
					local l = label(tickLayer, labels[i] or tostring(i), UDim2.fromOffset(PLOT_X + x - 28, PLOT_Y + PH + 3), UDim2.fromOffset(56, 16), Enum.Font.SourceSans, 12, Enum.TextXAlignment.Center)
					l.TextColor3 = COLORS.SubText
				end

				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						local px, py, pi
						for i = math.max(1, viewStart - 1), math.min(n, viewEnd + 1) do
							local value = s.Values[i]
							if type(value) == "number" then
								local x = xAt(i, n)
								local y = PH - (value - lo) / math.max(1e-9, hi - lo) * PH
								if px then
									local sc = segColor(s, pi, i)
									if animated then
										drawAnimatedSegment(lineLayer, px, py, x, y, sc, 0.16)
									else
										segment(lineLayer, px, py, x, y, sc, 2)
									end
								end
								if visibleCount <= 30 then
									local dot = create("Frame", {
										AnchorPoint = Vector2.new(0.5, 0.5),
										BackgroundColor3 = pointColor(s, i),
										BorderSizePixel = 0,
										Position = UDim2.fromOffset(x, y),
										Size = UDim2.fromOffset(7, 7),
										ZIndex = 4,
									}, lineLayer)
									create("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
									if animated then
										local sc = create("UIScale", { Scale = 0.2 }, dot)
										tween(sc, { Scale = 1 })
									end
								end
								px, py, pi = x, y, i
							else
								px, py, pi = nil, nil, nil
							end
						end
					end
				end
			end

			local function showIndex(index)
				local n = count()
				if n <= 0 then return end
				index = math.clamp(math.floor(index + 0.5), 1, n)
				local x = xAt(index, n)
				hoverLayer:ClearAllChildren()
				create("Frame", {
					BackgroundColor3 = Color3.new(1, 1, 1),
					BackgroundTransparency = 0.6,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(x, 0),
					Size = UDim2.fromOffset(1, PH),
				}, hoverLayer)

				local parts = { labels[index] or tostring(index) }
				for _, id in ipairs(order) do
					local s = series[id]
					if s then
						local value = s.Values[index]
						if type(value) == "number" then
							local y = PH - (value - viewLo) / math.max(1e-9, viewHi - viewLo) * PH
							local point = create("Frame", {
								AnchorPoint = Vector2.new(0.5, 0.5),
								BackgroundColor3 = Color3.new(1, 1, 1),
								BorderSizePixel = 0,
								Position = UDim2.fromOffset(x, y),
								Size = UDim2.fromOffset(9, 9),
								ZIndex = 9,
							}, hoverLayer)
							create("UICorner", { CornerRadius = UDim.new(1, 0) }, point)
							create("UIStroke", { Color = pointColor(s, index), Thickness = 2 }, point)
							parts[#parts + 1] = s.Name .. ": " .. fmt(value)
						end
					end
				end

				readout.Text = table.concat(parts, "   ")
				instantChartTooltip(hit, labels[index] or tostring(index), table.concat(parts, "\n"))

				local visibleCount = math.max(1, viewEnd - viewStart)
				local alpha = clamp01((index - viewStart) / visibleCount)
				scrubFill.Size = UDim2.fromOffset(alpha * PW, 4)
				scrubHandle.Position = UDim2.fromOffset(alpha * PW, 2)
			end

			local function hover()
				local n = count()
				if n <= 0 then return end
				local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
				if rel.X < 0 or rel.X > PW or rel.Y < 0 or rel.Y > PH then return end
				local visibleCount = viewEnd - viewStart + 1
				local index = visibleCount <= 1 and viewStart or math.clamp(math.floor(viewStart + clamp01(rel.X / PW) * visibleCount), 1, n)
				showIndex(index)
			end

			local scrubDragging = false
			local function scrubToX(x)
				local n = count()
				if n <= 0 then return end
				local alpha = clamp01(x / PW)
				local index = math.floor(viewStart + alpha * (viewEnd - viewStart) + 0.5)
				showIndex(index)
			end

			local function beginScrub(input)
				scrubDragging = true
				local x = input.Position.X - scrubTrack.AbsolutePosition.X
				scrubToX(x)
			end

			scrubTrack.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					beginScrub(input)
				end
			end)
			scrubHandle.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					beginScrub(input)
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if scrubDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local x = UIS:GetMouseLocation().X - scrubTrack.AbsolutePosition.X
					scrubToX(x)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					scrubDragging = false
				end
			end)

			hit.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement then
					hover()
				elseif input.UserInputType == Enum.UserInputType.MouseWheel then
					local n = count()
					if n <= 1 then return end
					local rel = UIS:GetMouseLocation() - plot.AbsolutePosition
					viewStart, viewEnd = zoomCategoricalRange(viewStart, viewEnd, n, rel.X / PW, input.Position.Z > 0 and 0.78 or (1 / 0.78))
					redraw(false)
					hover()
				end
			end)

			hit.InputBegan:Connect(function(input)
				if not isPress(input) then return end
				local n = count()
				if input.UserInputType == Enum.UserInputType.MouseButton1 and n > 1 then
					dragging = true
					dragX = UIS:GetMouseLocation().X
					dragStart, dragEnd = viewStart, viewEnd
				end
			end)

			hit.MouseLeave:Connect(function()
				hoverLayer:ClearAllChildren()
				readout.Text = "Hover the graph"
				instantChartTooltip(hit)
			end)

			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
			end)
			UIS.InputChanged:Connect(function(input)
				if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
					local n = count()
					if n > 1 then
						local span = dragEnd - dragStart + 1
						local dx = UIS:GetMouseLocation().X - dragX
						local shift = math.floor(dx / PW * span + (dx >= 0 and 0.5 or -0.5))
						viewStart, viewEnd = clampCategoricalRange(dragStart - shift, dragEnd - shift, n)
						redraw(false)
						hover()
					end
				end
			end)

			d.onToggle = function(state)
				openBtn.Text = name .. (state and "  <" or "  >")
				tween(openBtn, { BackgroundColor3 = state and COLORS.Accent or COLORS.Widget })
				setChartSelected(openBtn, state)
				if state then
					resetView(); rebuildLegend(); redraw(true)
					if lineHoverPoll then lineHoverPoll:Disconnect() end
					local rainbowClock = 0
					lineHoverPoll = RunService.RenderStepped:Connect(function(dt)
						if not d.isOpen then return end
						if rainbowMode then
							-- rainbow mode: the hues flow along the lines
							rainbowClock += dt
							if rainbowClock >= 0.05 then
								rainbowShift = (rainbowShift + rainbowClock * 0.25) % 1
								rainbowClock = 0
								redraw(false)
							end
						end
						hover()
					end)
				else
					if lineHoverPoll then lineHoverPoll:Disconnect(); lineHoverPoll=nil end
				end
			end
			openBtn.MouseButton1Click:Connect(function() d.setOpen(not d.isOpen) end)
			clearBtn.MouseButton1Click:Connect(function() chart:Clear() end)
			rainbowBtn.MouseButton1Click:Connect(function() chart:SetRainbowMode(not rainbowMode) end)
			fitBtn.MouseButton1Click:Connect(function() resetView(); redraw(false) end)

			function chart:SetLabels(list)
				labels = {}
				for i, value in ipairs(list or {}) do labels[i] = tostring(value) end
				resetView()
				if d.isOpen then redraw(true) end
				return chart
			end
			local function asColorSequence(value, endColor)
				if typeof(value) == "ColorSequence" then return value end
				if typeof(value) == "Color3" and typeof(endColor) == "Color3" then return ColorSequence.new(value, endColor) end
				if type(value) == "table" then
					local colors = {}
					for _, col in ipairs(value) do if typeof(col) == "Color3" then colors[#colors + 1] = col end end
					if #colors >= 2 then
						local keys = {}
						for i, col in ipairs(colors) do keys[#keys + 1] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), col) end
						return ColorSequence.new(keys)
					end
				end
				return nil
			end

			-- ranges can use a Color3 or a ColorSequence/list of colours.
			function chart:SetSeries(id, values, color, ranges)
				local s = ensure(id, typeof(color) == "Color3" and color or nil)
				if color == "rainbow" then s.Rainbow = true end
				s.Values = {}
				for i, value in ipairs(values or {}) do s.Values[i] = value end
				s.Ranges, s.PointColors = {}, {}
				for _, r in ipairs(ranges or {}) do
					local sequence = asColorSequence(r[3])
					if typeof(r[3]) == "Color3" or sequence then
						s.Ranges[#s.Ranges + 1] = { from = math.min(r[1], r[2]), to = math.max(r[1], r[2]), color = sequence or r[3] }
					end
				end
				resetView(); rebuildLegend()
				if d.isOpen then redraw(true) end
				return chart
			end

			-- Colour every point (and the line between them) from `first` to `last`.
			function chart:ColorRange(id, first, last, color, endColor)
				local s = series[id]
				if not s or type(first) ~= "number" or type(last) ~= "number" then return chart end
				local sequence = asColorSequence(color, endColor)
				if typeof(color) ~= "Color3" and not sequence then return chart end
				first, last = math.floor(first), math.floor(last)
				if first > last then first, last = last, first end
				first = math.clamp(first, 1, math.max(1, count()))
				last = math.clamp(last, first, math.max(first, count()))
				table.insert(s.Ranges, { from = first, to = last, color = sequence or color })
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end

			function chart:SetGradient(id, colors, first, last)
				local s = series[id]
				local sequence = asColorSequence(colors)
				if not s or not sequence then return chart end
				s.Rainbow = false
				if type(first) == "number" and type(last) == "number" then
					for index = math.min(first, last), math.max(first, last) do s.PointColors[math.floor(index)] = nil end
					return chart:ColorRange(id, first, last, sequence)
				end
				s.Ranges = { { from = 1, to = math.max(1, count()), color = sequence } }
				s.PointColors = {}
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end

			-- whole-line colour (clears per-range colours) or rainbow
			function chart:SetSeriesColor(id, color)
				local s = series[id]
				if not s or typeof(color) ~= "Color3" then return chart end
				s.Color, s.Rainbow = color, false
				s.Ranges, s.PointColors = {}, {}
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end
			function chart:SetRainbow(id, state)
				local s = series[id]
				if not s then return chart end
				s.Rainbow = state ~= false
				s.Ranges, s.PointColors = {}, {}
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end
			function chart:GetSeriesColor(id)
				local s = series[id]
				if not s then return nil end
				if s.Rainbow then return "rainbow" end
				return s.Color
			end
			function chart:IsRainbow(id) local s = series[id]; return s ~= nil and s.Rainbow end
			-- rainbow mode: every series is drawn with a flowing rainbow (also the "Rainbow" button in the panel)
			function chart:SetRainbowMode(state)
				rainbowMode = state ~= false
				tween(rainbowBtn, { BackgroundColor3 = rainbowMode and COLORS.Accent or COLORS.Widget })
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end
			function chart:IsRainbowMode() return rainbowMode end
			function chart:SetPointColor(id, index, color)
				local s = series[id]
				if not s or type(index) ~= "number" then return chart end
				s.PointColors[math.floor(index)] = typeof(color) == "Color3" and color or nil
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end

			-- id optional: with no id every series is reset to its own colour
			function chart:ClearColors(id)
				for sid, s in pairs(series) do
					if id == nil or sid == id then s.Ranges, s.PointColors = {}, {} end
				end
				rebuildLegend()
				if d.isOpen then redraw(false); hover() end
				return chart
			end

			function chart:GetColorRanges(id)
				local out = {}
				local s = series[id]
				if s then
					for _, r in ipairs(s.Ranges) do out[#out + 1] = { First = r.from, Last = r.to, Color = r.color } end
				end
				return out
			end

			function chart:GetPointColor(id, index)
				local s = series[id]
				return s and pointColor(s, index) or nil
			end

			-- current data: { [seriesId] = {values...} }
			function chart:Get()
				local out = {}
				for _, id in ipairs(order) do
					local s = series[id]
					if s then out[id] = table.clone(s.Values) end
				end
				return out
			end
			function chart:GetSeries(id) local s = series[id]; return s and table.clone(s.Values) or nil end
			function chart:GetLabels() return table.clone(labels) end
			function chart:AddValue(id, value, labelText)
				local s = ensure(id)
				s.Values[#s.Values + 1] = type(value) == "number" and value or 0
				if labelText ~= nil then labels[#s.Values] = tostring(labelText) end
				resetView()
				if d.isOpen then redraw(true) end
				return chart
			end
			function chart:RemoveSeries(id)
				if series[id] then
					series[id] = nil
					local index = table.find(order, id)
					if index then table.remove(order, index) end
					resetView(); rebuildLegend()
					if d.isOpen then redraw(true) end
				end
				return chart
			end
			function chart:Clear()
				series, order, paletteIndex = {}, {}, 0
				resetView(); rebuildLegend()
				if d.isOpen then redraw(true) end
				return chart
			end
			function chart:SetRange(lo, hi)
				if type(lo) ~= "number" then lo = nil end
				if type(hi) ~= "number" then hi = nil end
				fixedMin, fixedMax = lo, hi
				if d.isOpen then redraw(false); hover() end
				return chart
			end
			function chart:SetTitle(t) d.title.Text = tostring(t); return chart end
			function chart:Open() d.setOpen(true) end
			function chart:Close() d.setOpen(false) end
			function chart:Toggle() d.setOpen(not d.isOpen) end
			function chart:IsOpen() return d.isOpen end

			return finalize(row, chart):SetTooltip({
				Header = "Line Graph",
				Text = "Wheel = zoom\nDrag = pan\nRainbow = animated rainbow mode\nMulti-colour series show a gradient key\nFit = show all data",
			})
		end



		-- Viewport viewer --------------------------------------------------
		function Section:CreateViewport(name, source, options)
			options = options or {}
			local PANEL_W, PANEL_H = 400, 322
			local viewer = {}
			local explicitSource = source ~= nil
			local characterConn

			local row = newRow(name .. "Viewport")
			local openBtn = newButton(row, name .. "  >", UDim2.new(0.053, 0, 0, 3), UDim2.new(0, 153, 0, 24))
			openBtn.Name = "Button"

			local d = dock(window, PANEL_W, PANEL_H, options.Title or name, safeName .. "ViewportPanel")
			local autoRotate = options.AutoRotate == true
			local rotateSpeed = tonumber(options.RotateSpeed) or 0.8
			local dragging, dragLast = false, nil
			local displayModel
			local radius, distance = 5, 8
			local yaw, pitch = math.rad(35), math.rad(-12)

			local autoBtn = d.barButton(autoRotate and "Auto" or "Manual", 10, 48)
			local resetBtn = d.barButton("Reset", PANEL_W - 86, 50)

			local viewport = create("ViewportFrame", {
				Name = "Viewport",
				Active = true,
				BackgroundColor3 = COLORS.Plot,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Position = UDim2.fromOffset(10, 38),
				Size = UDim2.fromOffset(PANEL_W - 20, 244),
				Ambient = Color3.fromRGB(205, 205, 205),
				LightColor = Color3.fromRGB(255, 255, 255),
				LightDirection = Vector3.new(-1, -1, -1),
			}, d.panel)
			corner(viewport, 5)
			create("UIStroke", { Color = COLORS.Stroke, Thickness = 1 }, viewport)

			local world = Instance.new("WorldModel")
			world.Name = "World"
			world.Parent = viewport

			local camera = Instance.new("Camera")
			camera.Name = "ViewportCamera"
			camera.FieldOfView = math.clamp(tonumber(options.FieldOfView) or 50, 20, 100)
			camera.Parent = viewport
			viewport.CurrentCamera = camera

			local readout = label(d.panel, "No object", UDim2.fromOffset(10, 288), UDim2.fromOffset(PANEL_W - 20, 18), Enum.Font.SourceSans, 13, Enum.TextXAlignment.Center)
			readout.TextColor3 = COLORS.SubText

			local function clearWorld()
				for _, child in ipairs(world:GetChildren()) do child:Destroy() end
				displayModel = nil
			end

			local function getBounds(model)
				local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
				if ok and cf and size and size.Magnitude > 0 then
					return cf, size
				end

				local minV = Vector3.new(math.huge, math.huge, math.huge)
				local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
				local found = false
				for _, part in ipairs(model:GetDescendants()) do
					if part:IsA("BasePart") then
						local half = part.Size * 0.5
						local pos = part.Position
						minV = Vector3.new(math.min(minV.X, pos.X - half.X), math.min(minV.Y, pos.Y - half.Y), math.min(minV.Z, pos.Z - half.Z))
						maxV = Vector3.new(math.max(maxV.X, pos.X + half.X), math.max(maxV.Y, pos.Y + half.Y), math.max(maxV.Z, pos.Z + half.Z))
						found = true
					end
				end
				if not found then return CFrame.new(), Vector3.new(2, 2, 2) end
				return CFrame.new((minV + maxV) * 0.5), maxV - minV
			end

			local function updateCamera()
				if not displayModel then return end
				local cf, size = getBounds(displayModel)
				local center = cf.Position
				local maxDim = math.max(size.X, size.Y, size.Z)
				radius = math.max(0.1, maxDim * 0.5)
				local ideal = radius / math.tan(math.rad(camera.FieldOfView * 0.5)) * 1.35
				distance = math.clamp(distance, radius * 1.02, radius * 12)
				if distance <= radius * 1.03 then distance = ideal end
				camera.CFrame = CFrame.new(center) * CFrame.Angles(pitch, yaw, 0) * CFrame.new(0, 0, distance)
			end

			local function frameObject()
				if not displayModel then return end
				local boundsCF, size = getBounds(displayModel)
				local maxDim = math.max(size.X, size.Y, size.Z)
				radius = math.max(0.1, maxDim * 0.5)
				distance = radius / math.tan(math.rad(camera.FieldOfView * 0.5)) * 1.35
				pcall(function()
					camera:ZoomToExtents(boundsCF, size)
				end)
				updateCamera()
			end

			local function setObject(object)
				clearWorld()
				if object == nil and not explicitSource then object = Players.LocalPlayer.Character end
				if object == nil then readout.Text = explicitSource and "No object" or "Waiting for character..."; return end
				local holder = Instance.new("Model")
				holder.Name = "Display"
				holder.Parent = world

				local ok, clone = pcall(function() return object:Clone() end)
				if not ok or not clone then
					holder:Destroy()
					readout.Text = "Could not clone object"
					return
				end

				clone.Parent = holder
				for _, child in ipairs(holder:GetDescendants()) do
					if child:IsA("BasePart") then
						child.Anchored = true
						child.CanCollide = false
						child.CanTouch = false
						child.CanQuery = false
					elseif child:IsA("Script") or child:IsA("LocalScript") then
						child.Enabled = false
					end
				end

				local boundsCF = select(1, getBounds(holder))
				holder:PivotTo(CFrame.new(-boundsCF.Position) * holder:GetPivot())
				displayModel = holder
				readout.Text = "Wheel = zoom   |   Drag = rotate   |   Auto = " .. tostring(autoRotate)
				frameObject()
			end

			local function reset()
				yaw, pitch = math.rad(35), math.rad(-12)
				frameObject()
			end

			autoBtn.MouseButton1Click:Connect(function()
				autoRotate = not autoRotate
				autoBtn.Text = autoRotate and "Auto" or "Manual"
				readout.Text = "Wheel = zoom   |   Drag = rotate   |   Auto = " .. tostring(autoRotate)
			end)

			-- Orbit-drag: track the specific InputObject that started the
			-- drag (same reliable pattern used for window/panel dragging)
			-- instead of a separate global InputEnded listener, and accept
			-- touch as well as the mouse.
			viewport.InputBegan:Connect(function(input)
				if not isPress(input) then return end
				dragging = true
				dragLast = pointerPos(input)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						dragLast = nil
					end
				end)
			end)
			viewport.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseWheel and displayModel then
					local factor = input.Position.Z > 0 and 0.82 or (1 / 0.82)
					distance = math.clamp(distance * factor, radius * 1.02, radius * 12)
					updateCamera()
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if dragging and displayModel and (isMove(input) or input.UserInputType == Enum.UserInputType.Touch) then
					local mouse = pointerPos(input)
					if dragLast then
						local delta = mouse - dragLast
						yaw -= delta.X * 0.008
						pitch = math.clamp(pitch - delta.Y * 0.006, math.rad(-80), math.rad(80))
						updateCamera()
					end
					dragLast = mouse
				end
			end)

			RunService.RenderStepped:Connect(function(dt)
				if displayModel and d.isOpen and autoRotate and not dragging then
					yaw += dt * rotateSpeed
					updateCamera()
				end
			end)

			d.onToggle = function(state)
				openBtn.Text = name .. (state and "  <" or "  >")
				tween(openBtn, { BackgroundColor3 = state and COLORS.Accent or COLORS.Widget })
				setChartSelected(openBtn, state)
				if state then
					if displayModel then
						frameObject()
					else
						updateCamera()
					end
				end
			end

			openBtn.MouseButton1Click:Connect(function() d.setOpen(not d.isOpen) end)
			resetBtn.MouseButton1Click:Connect(reset)

			function viewer:Set(object)
				explicitSource = object ~= nil
				source = object
				setObject(object)
				return viewer
			end
			function viewer:Clear()
				explicitSource = true
				source = nil
				clearWorld(); readout.Text = "No object"
				return viewer
			end
			function viewer:UsePlayerCharacter()
				explicitSource = false
				source = Players.LocalPlayer.Character
				setObject(source)
				return viewer
			end
			function viewer:Refresh() setObject(source); return viewer end
			function viewer:Get() return source end
			function viewer:IsAutoRotating() return autoRotate end
			function viewer:SetAutoRotate(state) autoRotate = state and true or false; autoBtn.Text = autoRotate and "Auto" or "Manual"; return viewer end
			function viewer:SetRotateSpeed(speed) if type(speed) == "number" then rotateSpeed = speed end; return viewer end
			function viewer:SetFieldOfView(fov) if type(fov) == "number" then camera.FieldOfView = math.clamp(fov, 20, 100); frameObject() end; return viewer end
			function viewer:Reset() reset(); return viewer end
			function viewer:SetTitle(t) d.title.Text = tostring(t); return viewer end
			function viewer:Open() d.setOpen(true) end
			function viewer:Close() d.setOpen(false) end
			function viewer:Toggle() d.setOpen(not d.isOpen) end
			function viewer:IsOpen() return d.isOpen end

			characterConn = Players.LocalPlayer.CharacterAdded:Connect(function(character)
				if not explicitSource then
					task.defer(function()
						if not explicitSource and gui.Parent then
							 source = character
							 setObject(character)
						end
					end)
				end
			end)

			setObject(source)

			return finalize(row, viewer):SetTooltip({
				Header = "Viewport",
				Text = "3D object preview\nWheel = zoom\nDrag = rotate\nAuto rotates when enabled",
			})
		end

		-- record every element so Library:GetValue / GetValues / Find can reach it
		for fname, fn in pairs(Section) do
			if type(fn) == "function" and string.sub(fname, 1, 6) == "Create" then
				Section[fname] = function(self, first, ...)
					local obj = fn(self, first, ...)
					if type(obj) == "table" then
						local tips = {
							Toggle = "Click to switch this on or off.",
							Slider = "Drag the bar, or click it, to set the value.",
							Button = "Click to run this action.",
							Textbox = "Type something, then press Enter to submit it.",
							Dropdown = "Click to open the list and pick an option.",
							ColorPicker = "Click the swatch to open the picker. Rainbow cycles the colour.",
							Keybind = "Click, then press a key to bind it. Esc cancels, Backspace clears.",
							Sparkline = "Live mini graph of the most recent values.",
							Comparison = "Shows how a value changed, with the percentage difference.",
						}
						local kind = string.sub(fname, 7)
						if tips[kind] and obj.__SetDefaultTip then
							obj:__SetDefaultTip({ Header = tostring(first), Text = tips[kind] })
						end
						Library:_Register(tostring(title), tostring(sectionTitle), tostring(first), string.sub(fname, 7), obj)
					end
					return obj
				end
			end
		end

		applySearch()
		return Section
	end

	return Window
end

function Library:CreateLoggerWindow(title, options)
	local window = self:NewWindow(title or "Event Log")
	local section = window:NewSection("Timeline")
	local logger = section:CreateLogger("Open Log", options or {Title="Notification Timeline"})
	return logger, window
end

