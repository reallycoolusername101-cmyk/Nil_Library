-- Real screen size expressed in container units (the container carries the UIScale)
local function screenUnits()
	local s = gui.AbsoluteSize
	local k = math.max(uiScale.Scale, 0.01)
	return Vector2.new(s.X / k, s.Y / k)
end

-- clamp a wanted top-left position (container units) so the frame stays reachable
local function clampPos(x, y, size)
	local scr = screenUnits()
	local minX = math.min(0, scr.X - size.X)
	local maxX = math.max(0, scr.X - size.X)
	if size.X > scr.X then minX, maxX = scr.X - size.X, 0 end
	local maxY = math.max(0, scr.Y - math.min(size.Y, ROW * 4))
	return math.clamp(x, minX, maxX), math.clamp(y, 0, maxY)
end

-- re-clamp a frame where it currently is (used when the screen / UI scale changes)
local function clampOnScreen(target)
	local k = math.max(uiScale.Scale, 0.01)
	local pos = (target.AbsolutePosition - container.AbsolutePosition) / k
	local x, y = clampPos(pos.X, pos.Y, target.AbsoluteSize / k)
	target.Position = UDim2.fromOffset(x, y)
end

-- Drag via a transparent title-bar hit surface so labels cannot swallow the input.
local function makeDraggable(handle, target, opts)
	opts = opts or {}
	if not handle or not target then return end
	handle.Active = true
	local activeDrag = false
	handle.InputBegan:Connect(function(input)
		if activeDrag or not isPress(input) then return end
		if opts.canDrag and not opts.canDrag() then return end
		activeDrag = true
		local touch = input.UserInputType == Enum.UserInputType.Touch
		local scale = math.max(uiScale.Scale, 0.01)
		local startPointer = pointerPos(input)
		local startPos = (target.AbsolutePosition - container.AbsolutePosition) / scale
		local targetSize = target.AbsoluteSize / scale
		local moveConn, endConn, touchConn
		local finished = false
		local function finish()
			if finished then return end
			finished = true
			activeDrag = false
			if moveConn then moveConn:Disconnect(); moveConn = nil end
			if endConn then endConn:Disconnect(); endConn = nil end
			if touchConn then touchConn:Disconnect(); touchConn = nil end
			if opts.onEnd then opts.onEnd() end
		end
		if opts.onStart then opts.onStart() end
		-- The position is recomputed EVERY frame from the live pointer, relative to the exact spot that
		-- was grabbed, so the window can never lag behind or drift away from the cursor.
		local touchPointer = startPointer
		local touchConn
		if touch then
			touchConn = UIS.InputChanged:Connect(function(changed)
				if changed.UserInputType == Enum.UserInputType.Touch and changed == input then
					touchPointer = pointerPos(changed)
				end
			end)
		end
		local lastX, lastY
		moveConn = RunService.RenderStepped:Connect(function()
			if not target.Parent then finish() return end
			if not touch and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				finish()
				return
			end
			local pointer = touch and touchPointer or UIS:GetMouseLocation()
			local delta = (pointer - startPointer) / math.max(uiScale.Scale, 0.01)
			local x, y = clampPos(startPos.X + delta.X, startPos.Y + delta.Y, targetSize)
			if x ~= lastX or y ~= lastY then
				lastX, lastY = x, y
				target.Position = UDim2.fromOffset(x, y)
			end
		end)
		endConn = UIS.InputEnded:Connect(function(ended)
			if (touch and ended.UserInputType == Enum.UserInputType.Touch)
				or (not touch and ended.UserInputType == Enum.UserInputType.MouseButton1) then
				finish()
			end
		end)
	end)
end

