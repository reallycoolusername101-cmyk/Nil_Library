local function tween(obj, props)
	if not obj or not obj.Parent then
		return
	end
	pcall(function()
		TweenService:Create(obj, TWEEN_INFO, props):Play()
	end)
end

-- Theme registry: every instance whose colour property was set from a COLORS.* role at
-- creation time is tracked (weakly) with the role it came from, so a theme change can
-- retint it in place. Properties covered: backgrounds, text, images, scrollbars, UIStroke.
local THEME_PROPS = {
	BackgroundColor3 = { "Window", "Body", "Section", "Widget", "Accent", "Accent2", "Deep", "Plot", "Track", "Knob", "Raised", "Hover", "Grid", "Axis" },
	TextColor3 = { "Text", "SubText", "Accent", "Accent2" },
	PlaceholderColor3 = { "SubText", "Text" },
	ImageColor3 = { "Text", "SubText", "Accent", "Accent2" },
	ScrollBarImageColor3 = { "SubText", "Text", "Accent", "Accent2" },
	Color = { "Widget", "Stroke", "Accent", "Accent2", "Section", "Window" }, -- UIStroke
}
local themed = setmetatable({}, { __mode = "k" }) -- inst -> { prop = role }

local function create(class, props, parent)
	local inst = Instance.new(class)
	local themeable = props.NoTheme ~= true
	local explicit = props.ThemeRoles
	for k, v in pairs(props) do
		if k ~= "NoTheme" and k ~= "ThemeRoles" then
			inst[k] = v
		end
	end
	inst.Parent = parent
	if themeable then
		for prop, roles in pairs(THEME_PROPS) do
			local v = props[prop]
			if typeof(v) == "Color3" and (prop ~= "Color" or class == "UIStroke") then
				local found = explicit and explicit[prop]
				if not found then
					for _, role in ipairs(roles) do
						if COLORS[role] == v then found = role break end
					end
				end
				if found then
					themed[inst] = themed[inst] or {}
					themed[inst][prop] = found
				end
			end
		end
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 4) }, parent)
end

-- make a text object shrink to fit instead of overflowing
local function fitText(inst, maxSize, pad)
	inst.TextScaled = true
	create("UITextSizeConstraint", { MaxTextSize = maxSize or 14, MinTextSize = 6 }, inst)
	if pad then
		create("UIPadding", { PaddingLeft = UDim.new(0, pad), PaddingRight = UDim.new(0, pad) }, inst)
	end
end

local function label(parent, text, pos, size, font, textSize, xAlign, noScale)
	local l = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = pos,
		Size = size,
		Font = font or Enum.Font.SourceSansBold,
		Text = text,
		TextColor3 = COLORS.Text,
		TextSize = textSize or 17,
		TextXAlignment = xAlign or Enum.TextXAlignment.Left,
	}, parent)
	if not noScale then
		fitText(l, textSize or 17)
	end
	return l
end

local function clamp01(n)
	return math.clamp(n, 0, 1)
end

-- Screen position of the pointer (gui is created with IgnoreGuiInset, so this matches AbsolutePosition)
local function pointerPos(input)
	if input and input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
	end
	return UIS:GetMouseLocation()
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function fmt(v)
	if math.abs(v) < 1e-9 then
		return "0"
	end
	return tostring(tonumber(string.format("%.4g", v)))
end

