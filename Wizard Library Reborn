local metricUnits = {"", "k", "M", "B", "T", "Qa", "Qi"}

function Library:FormatNumber(value, options)
	options = options or {}
	value = tonumber(value) or 0

	local rate = tonumber(options.Rate or options.ConversionRate) or 1
	if rate == 0 then rate = 1 end
	value /= rate

	local absolute = math.abs(value)
	local index = 1
	while absolute >= 1000 and index < #metricUnits do
		value /= 1000
		absolute /= 1000
		index += 1
	end

	local decimals = options.Decimals
	if type(decimals) ~= "number" then
		if math.abs(value) >= 100 then
			decimals = 0
		elseif math.abs(value) >= 10 then
			decimals = 1
		else
			decimals = 2
		end
	end

	local text = string.format("%." .. math.max(0, math.floor(decimals)) .. "f", value)
	text = text:gsub("(%..-)0+$", "%1"):gsub("%.$", "")

	return text .. metricUnits[index] .. tostring(options.Unit or "")
end

Library.FormatValue = Library.FormatNumber
function Library:FormatWithUnit(value, unit, rate, decimals)
	return self:FormatNumber(value, {Unit = unit, Rate = rate, Decimals = decimals})
end

function Library:CompareValues(oldValue, newValue)
	local old = tonumber(oldValue) or 0
	local new = tonumber(newValue) or 0
	local difference = new - old
	local percent

	if old == 0 then
		percent = difference == 0 and 0 or math.huge
	else
		percent = difference / math.abs(old) * 100
	end

	local direction
	if difference > 0 then
		direction = "increase"
	elseif difference < 0 then
		direction = "decrease"
	else
		direction = "unchanged"
	end

	local percentText
	if percent == math.huge then
		percentText = (difference < 0 and "-inf%" or "+inf%")
	else
		percentText = string.format("%+.2f%%", percent)
	end

	return {
		From = old,
		To = new,
		Difference = difference,
		Percent = percent,
		Direction = direction,
		Text = Library:FormatNumber(old) .. " -> " .. Library:FormatNumber(new) .. " (" .. percentText .. ")",
	}
end

Library.Compare = Library.CompareValues

