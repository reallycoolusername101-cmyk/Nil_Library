-- WizardLibrary (cleaned-up rewrite, v2)
--
-- Library:NewWindow(title)                       -> Window
-- Window:NewSection(title)                       -> Section
--
-- Section:CreateToggle(name, callback)                           callback(state)
-- Section:CreateSlider(name, min, max, default, precise, cb)     cb(value)
-- Section:CreateButton(name, callback)                           callback()
-- Section:CreateTextbox(name, callback)                          callback(text)  (on Enter)
-- Section:CreateDropdown(name, list, defaultIndex, callback, {PopOut = true, Multi = false})   callback(option)
--        click the header: the list pops out beside the window, on the left or right (whichever has more room),
--        and stays open until you click/tap outside it. Options: CloseOnSelect = true to close after a pick.
--        (PopOut = false = inline list)
-- Section:CreateColorPicker(name, defaultColor, callback)        callback(color3)
-- Section:CreateText(header, text)                               :SetText(text, ...) :SetHeader(h) :GetText()
-- Section:CreateKeybind(name, defaultKeyCode, callback, onChanged)
--        click the button, press a key to rebind (Esc = cancel, Backspace = clear)
--        callback(keyCode) fires whenever the bound key is pressed, onChanged(keyCode) when it is rebound
-- Section:CreateGraph(name, {Title, XMin, XMax, YMin, YMax, AutoFit})
--        :Plot(id, points, color)               points = {{x,y}, Vector2, ...}
--        :PlotFunction(id, fn, {Color, Steps, XMin, XMax})   (follows the visible range unless XMin/XMax given)
--        :AddPoint(id, x, y) / :AddPoints(id, pts) / :RemovePoint(id, index) / :Remove(id) / :Clear()
--        :SetRange(xmin, xmax, ymin, ymax) / :Fit() / :Open() / :Close() / :Toggle()
--        In the panel: mouse wheel = zoom, drag = pan, hover = coordinates, "x" on a legend chip = remove series.
--
-- Section:CreateBarChart(name, {Title, Data, YMin, YMax, ShowValues})
-- Section:CreatePieChart(name, {Title, Data})
--        Data = {{"Label", value}, {Label=, Value=, Color=}} or {Label = value, ...}
--        :Set(data) :Add(label, value, color) :SetValue(label, value) :Remove(label) :Clear()
--        bar also has :Sort(descending) :SetRange(lo, hi)
-- Section:CreateLineGraph(name, {Title, Labels, YMin, YMax})   (labelled x axis, multiple series)
--        :SetLabels({...}) :SetSeries(id, values, color) :AddValue(id, value, label) :RemoveSeries(id) :Clear()
-- Section:CreateViewport(name, source, {Title, AutoRotate, RotateSpeed, FieldOfView})
-- Section:CreateSwitch(name, states, defaultIndex, callback)
-- Section:CreateSparkline(name, values, {Color, YMin, YMax})
-- Section:CreateLogger(name, {Title, Levels})
-- Window:CreateLoggerWindow(...)
-- Library:Notify({Title, Text, Type, Duration}) / Library:Log(level, message)
-- Library:ConfigureIntro({Enabled, Duration, BallColorA, BallColorB, BallSize, ParticleCount, ShakeStrength, Skippable})
-- UI scale: Library:SetUIScale("Small"|"Medium"|"Large"|"XL")
--          Library:CreateUIScaleControls(section, {Small, Medium, Large, XL, Default})
-- Intro: Library:PlayStarIntro({...same options...})   two orbs collide, click/tap skips it
-- Themes: Library:SetTheme(name) / :GetTheme() / :GetThemes() / :AddTheme(name, {Window,Body,Section,Widget,Accent, [Accent2,Accent3,Text,SubText]})
--         25 built in (14 single colour, 11 multi colour). Everything themes: surfaces, text, borders, grid lines,
--         tooltips, notification cards, scrollbars, gradient accent bars and the default chart palette.
--         Library:CreateThemeDropdown(section)
-- Values: every control has :Get()  (button = held state, :GetCount(), :GetLastPressed(); colour = :GetRGB() :GetHex();
--         keybind = :Get() :GetName(); graphs/charts/pie = :Get(), pie :GetSelected())
--         Library:GetValue(nameOrPath) / Library:GetValues() / Library:Find(name)
-- Panels: every chart panel drags by its title bar; the ring in its bottom-right corner pins it in place.
--         Double-click the title bar to snap it back next to its window.
-- Line graph: :ColorRange(id, firstIndex, lastIndex, color) :SetPointColor(id, i, color) :ClearColors([id])
--         :SetRainbowMode(bool) / :IsRainbowMode()   (also the Rainbow button in the panel)
--         Series with multiple colours display a smooth gradient in the legend key.
-- Library:Notify({Title, Text, Type, Duration}) and Library:Log(level, message)
--        source = Model/BasePart/Folder/other cloneable Instance; wheel = zoom, drag = rotate.
--        All chart/viewer types also have :Open() :Close() :Toggle() :IsOpen() :SetTitle(t).
--        Only one chart/viewer panel per window is open at a time.
--
-- Every element returned has :SetTooltip({Header, Text, Delay, Duration, Enabled}) or :SetTooltip(false).
-- Global tooltip defaults: Library:ConfigureTooltips({Enabled = true, Delay = 1, Duration = 0})
--
