				task.defer(function() pcall(function() scroll.CanvasPosition=Vector2.new(0,0) end) end)
			end
			local function renderAll()
				for _,child in ipairs(scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
				for i = #Library.Logger.Entries, 1, -1 do
					addEntry(Library.Logger.Entries[i])
				end
				task.defer(function() pcall(function() scroll.CanvasPosition = Vector2.new(0, 0) end) end)
			end
			unsubscribe=Library:SubscribeLogs(function(entry,cleared)
				if not d.isOpen then return end
				if cleared then renderAll() elseif entry then renderAll() end
			end)
			d.onToggle=function(state)
				openBtn.Text=name..(state and "  <" or "  >"); tween(openBtn,{BackgroundColor3=state and COLORS.Accent or COLORS.Widget}); setChartSelected(openBtn,state)
				if state then animatePanelIn(d.panel); renderAll() end
			end
			openBtn.MouseButton1Click:Connect(function() d.setOpen(not d.isOpen) end)
			clearBtn.MouseButton1Click:Connect(function() Library:ClearLogs() end)
			function logger:Refresh() renderAll(); return logger end
			function logger:Get() return table.clone(Library.Logger.Entries) end
			function logger:Clear() Library:ClearLogs(); return logger end
			function logger:Open() d.setOpen(true) end
			function logger:Close() d.setOpen(false) end
			function logger:Toggle() d.setOpen(not d.isOpen) end
			function logger:IsOpen() return d.isOpen end
			function logger:SetTitle(t) d.title.Text=tostring(t); return logger end
			return finalize(row,logger):SetTooltip({Header="Event Log",Text="Color-coded timeline for library events and notifications."})
		end

