local dockRegistry = setmetatable({}, { __mode = "k" })

local function registerDock(window, entry)
	dockRegistry[window] = dockRegistry[window] or {}
	table.insert(dockRegistry[window], entry)
end

-- only one chart panel per window is open at a time
local function closeOthers(window, entry)
	for _, other in ipairs(dockRegistry[window] or {}) do
		if other ~= entry then
			other.close()
		end
	end
end

-- Circular pin button placed OUTSIDE the target's bottom-right corner.
-- It is a sibling of the window/panel so it remains visible beyond the rounded edge.
local function lockCorner(target, onToggle)
	local host = target.Parent or container
	local btn = create("TextButton", {
		Name = "LockCorner",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = COLORS.Widget,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(18, 18),
		Text = "",
		Visible = false,
		ZIndex = 80,
	}, host)
	corner(btn, 999)
	local mark = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		ZIndex = 81,
	}, btn)
	corner(mark, 999)
	local stroke = create("UIStroke", { Color = COLORS.SubText, Thickness = 1.5 }, mark)
	local api = {}
	function api.paint(locked)
		tween(btn, { BackgroundColor3 = locked and COLORS.Accent or COLORS.Widget })
		stroke.Color = locked and COLORS.Text or COLORS.SubText
		mark.BackgroundTransparency = locked and 0 or 1
		mark.BackgroundColor3 = COLORS.Text
	end

	local lastPosition
	local updateConn
	local function updatePosition()
		if not target.Parent or not target.Visible then
			btn.Visible = false
			return
		end
		local scale = math.max(uiScale.Scale, 0.01)
		local topLeft = (target.AbsolutePosition - container.AbsolutePosition) / scale
		local size = target.AbsoluteSize / scale
		local screen = screenUnits()
		-- Keep the entire circle outside the bottom-right corner when there is room,
		-- but pull it onto the screen if a window is close to an edge.
		local position = Vector2.new(
			math.clamp(topLeft.X + size.X + 9, 9, math.max(9, screen.X - 9)),
			math.clamp(topLeft.Y + size.Y + 9, 9, math.max(9, screen.Y - 9))
		)
		if not lastPosition or (position - lastPosition).Magnitude > 0.25 then
			btn.Position = UDim2.fromOffset(position.X, position.Y)
			lastPosition = position
		end
		btn.Visible = true
	end

	updatePosition()
	updateConn = RunService.RenderStepped:Connect(function()
		if not target.Parent or not btn.Parent then
			if updateConn then updateConn:Disconnect() end
			if btn.Parent then btn:Destroy() end
			return
		end
		updatePosition()
	end)
	target:GetPropertyChangedSignal("Visible"):Connect(updatePosition)
	target.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if updateConn then updateConn:Disconnect() end
			if btn.Parent then btn:Destroy() end
		end
	end)
	btn.MouseButton1Click:Connect(onToggle)
	return btn, api
end

-- a panel docked to the right of a window (flips left if there is no room).
-- Every panel can be dragged by its title bar. The small ring in the bottom
-- right corner pins it: while pinned the panel stays exactly where it is.
local function dock(window, panelW, panelH, titleText, panelName)
	local d = { isOpen = false }
	local entry = { close = function() end }
	registerDock(window, entry)

	local panel = create("Frame", {
		Name = panelName,
		Visible = false,
		BackgroundColor3 = COLORS.Window,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromOffset(panelW, panelH),
		ZIndex = 20,
	}, container)
	corner(panel, 6)
	create("UIStroke", { Color = COLORS.Widget, Thickness = 1 }, panel)

	-- single UIScale: shrinks the panel to fit small screens and doubles as the open animation
	local fit = create("UIScale", { Name = "__WizardChartScale", Scale = 1 }, panel)
	local function fitFactor()
		local scr = screenUnits()
		return math.clamp(math.min((scr.X - 16) / panelW, (scr.Y - 16) / panelH, 1), 0.5, 1)
	end
	local function updateFit()
		panel:SetAttribute("FitScale", fitFactor())
		fit.Scale = fitFactor()
	end
	updateFit()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateFit)
	uiScale:GetPropertyChangedSignal("Scale"):Connect(updateFit)

	local bar = create("Frame", {
		Active = true,
		BackgroundColor3 = COLORS.Section,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(panelW, ROW),
		ZIndex = 21,
	}, panel)

	d.panel = panel
	d.bar = bar
	d.title = label(bar, titleText, UDim2.fromOffset(26, 0), UDim2.fromOffset(panelW - 136, ROW))
	d.title.ZIndex = 22
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		panel.Visible = d.isOpen and window.Visible
	end)

	function d.barButton(text, x, w)
		local b = create("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = COLORS.Widget,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, 4),
			Size = UDim2.fromOffset(w, 22),
			Font = Enum.Font.SourceSansBold,
			Text = text,
			TextColor3 = COLORS.Text,
			TextSize = 14,
			ZIndex = 24,
		}, bar)
		corner(b, 4)
		return b
	end

	d.closeBtn = d.barButton("X", panelW - 30, 24)
	local dragSurface = create("TextButton", {
		Name = "PanelDragSurface", AutoButtonColor = false,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -34, 1, 0),
		Text = "", ZIndex = 23,
	}, bar)

	local follow
	local manual = false
	local locked = false

	local function reposition()
		local k = math.max(uiScale.Scale, 0.01)
		local wp, ws = window.AbsolutePosition / k, window.AbsoluteSize / k
		local ps = panel.AbsoluteSize / k
		local scr = screenUnits()
		local x = wp.X + ws.X + 8
		if x + ps.X > scr.X then
			x = wp.X - ps.X - 8
		end
		x = math.clamp(x, 0, math.max(0, scr.X - ps.X))
		local y = math.clamp(wp.Y, 0, math.max(0, scr.Y - ps.Y))
		panel.Position = UDim2.fromOffset(x, y)
	end

	local function stopFollow()
		if follow then
			follow:Disconnect()
			follow = nil
		end
	end

	function d.setOpen(state)
		if state == d.isOpen then
			return
		end
		if state then
			closeOthers(window, entry)
		end
		d.isOpen = state
		panel.Visible = state
		stopFollow()
		if state and not manual then
			follow = RunService.RenderStepped:Connect(reposition)
			reposition()
		elseif state then
			clampOnScreen(panel)
		end
		if d.onToggle then
			d.onToggle(state)
		end
	end

	entry.close = function()
		d.setOpen(false)
	end
	d.closeBtn.MouseButton1Click:Connect(function()
		d.setOpen(false)
	end)

	-- Drag by the whole title bar; a quick double-click redocks without starting a drag.
	local lastTap = 0
	makeDraggable(dragSurface, panel, {
		canDrag = function()
			if locked then return false end
			local now = tick()
			if now - lastTap < 0.35 then
				lastTap = 0
				d.Redock()
				return false
			end
			lastTap = now
			return true
		end,
		onStart = function()
			manual = true
			stopFollow()
		end,
	})

	-- pin ring, bottom right: press it and the panel stops moving
	local paintPin
	local pin, pinApi = lockCorner(panel, function()
		d.setLocked(not locked)
	end)
	d.setLocked = function(state)
		locked = state and true or false
		if locked then
			manual = true
			stopFollow()
		end
		pinApi.paint(locked)
		return d
	end
	d.isLocked = function()
		return locked
	end
	bindHover(pin, { Header = "Lock", Text = "Press the corner to lock this panel in place.", Delay = 0.4, Enabled = true })

	d.Redock = function()
		if locked then return d end
		manual = false
		if d.isOpen and not follow then
			follow = RunService.RenderStepped:Connect(reposition)
			reposition()
		end
		return d
	end

	d.detach = function()
		manual = true
		stopFollow()
		return d
	end

	d.IsManual = function()
		return manual
	end

	return d
end

-- accepts {{"Label", value}, {Label=, Value=, Color=}, 1, 2, 3} or {Label = value, ...}
local function normalizeItems(data)
	local items = {}
	if type(data) ~= "table" then
		return items
	end
	if #data > 0 then
		for i, v in ipairs(data) do
			if type(v) == "number" then
				items[#items + 1] = { Label = tostring(i), Value = v }
			elseif type(v) == "table" then
				local lbl = v.Label or v.label or v.Name or v.name or v[1]
				local value = v.Value or v.value or v[2]
				if type(value) == "number" then
					items[#items + 1] = { Label = tostring(lbl), Value = value, Color = v.Color or v.color }
				end
			end
		end
	else
		local keys = {}
		for k, v in pairs(data) do
			if type(v) == "number" then
				keys[#keys + 1] = k
			end
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)
		for _, k in ipairs(keys) do
			items[#items + 1] = { Label = tostring(k), Value = data[k] }
		end
	end
	return items
end

-- horizontal grid lines + y tick labels (used by the bar and line charts)
local function buildYGrid(gridLayer, tickLayer, plotX, plotY, PW, PH, lo, hi)
	local range = hi - lo
	local step = niceStep(range, 5)
	local j0, j1 = math.ceil(lo / step - 1e-9), math.floor(hi / step + 1e-9)
	if j1 - j0 > 60 then
		return
	end
	for k = j0, j1 do
		local v = k * step
		local py = PH - (v - lo) / range * PH
		create("Frame", {
			BackgroundColor3 = (k == 0) and COLORS.Axis or COLORS.Grid,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, py),
			Size = UDim2.fromOffset(PW, k == 0 and 2 or 1),
		}, gridLayer)
		local l = label(tickLayer, fmt(v), UDim2.fromOffset(0, plotY + py - 7),
			UDim2.fromOffset(plotX - 4, 14), Enum.Font.SourceSans, 12, Enum.TextXAlignment.Right)
		l.TextColor3 = COLORS.SubText
	end
end

-- legend chips with a remove "x" (used by the graphs).
-- A multi-colour series gets a circular gradient key matching its point colours.
-- A rainbow series uses a vertical rainbow gradient. Clicking a chip selects that series.
local RAINBOW_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 220, 100)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 200, 230)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(110, 120, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 110, 240)),
})

local LEGEND_RAINBOW_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 20, 35)),
	ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 115, 0)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 245, 0)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(20, 220, 65)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 220, 220)),
	ColorSequenceKeypoint.new(0.83, Color3.fromRGB(20, 80, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(195, 0, 225)),
})

local function buildChips(legend, entries, onRemove, onSelect, activeId)
	for _, c in ipairs(legend:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, e in ipairs(entries) do
		local colors = e.colors or { e.color }
		local useGradient = e.rainbow or e.gradient ~= nil or #colors > 1
		local keyW = useGradient and 14 or 10
		local w = math.ceil(TextService:GetTextSize(e.name, 13, Enum.Font.SourceSansSemibold, Vector2.new(200, 20)).X) + 34 + keyW
		local chip = create("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = COLORS.Widget,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(w, 22),
		}, legend)
		corner(chip, 4)
		if activeId ~= nil and e.id == activeId then
			create("UIStroke", { Color = COLORS.Accent, Thickness = 1.2 }, chip)
		end
		local key = create("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = useGradient and 0 or 1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Position = UDim2.fromOffset(useGradient and 6 or 7, useGradient and 4 or 6),
			Size = UDim2.fromOffset(keyW, useGradient and 14 or 10),
			NoTheme = true,
		}, chip)
		corner(key, useGradient and 7 or 5)
		if useGradient then
			local sequence = e.gradient
			if not sequence and #colors > 1 then
				local keys = {}
				for ci, col in ipairs(colors) do
					keys[#keys + 1] = ColorSequenceKeypoint.new((ci - 1) / (#colors - 1), col)
				end
				sequence = ColorSequence.new(keys)
			end
			create("UIGradient", { Rotation = 90, Color = sequence or LEGEND_RAINBOW_SEQ }, key)
		else
			for ci, col in ipairs(colors) do
				create("Frame", {
					BackgroundColor3 = col,
					BorderSizePixel = 0,
					Position = UDim2.new((ci - 1) / #colors, 0, 0, 0),
					Size = UDim2.new(1 / #colors, 0, 1, 0),
					NoTheme = true,
				}, key)
			end
		end
		label(chip, e.name, UDim2.fromOffset(12 + keyW, 0), UDim2.fromOffset(w - 34 - keyW, 22),
			Enum.Font.SourceSansSemibold, 13, Enum.TextXAlignment.Left, true)
		if onSelect then
			local pick = create("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(w - 22, 22),
				Text = "",
				ZIndex = 3,
			}, chip)
			pick.MouseButton1Click:Connect(function()
				onSelect(e.id)
			end)
		end
		local x = create("TextButton", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(w - 20, 2),
			Size = UDim2.fromOffset(18, 18),
			Font = Enum.Font.SourceSansBold,
			Text = "x",
			TextColor3 = COLORS.SubText,
			TextSize = 14,
			ZIndex = 4,
		}, chip)
		x.MouseButton1Click:Connect(function()
			onRemove(e.id)
		end)
	end
end


