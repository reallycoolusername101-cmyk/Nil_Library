---------------------------------------------------------------------------
-- element registry: read any control's value by name, from anywhere
--   Library:GetValue("Enabled")                       -> that control's :Get()
--   Library:GetValue("Showcase/Toggles/Enabled")      -> full path form
--   Library:GetValues()                               -> { [path] = value, ... }
--   Library:Find("Enabled")                           -> the control object itself
---------------------------------------------------------------------------
Library.Registry = {}

function Library:_Register(win, sec, name, kind, obj)
	local base = win .. "/" .. sec .. "/" .. name
	local key, n = base, 1
	while self.Registry[key] do
		n += 1
		key = base .. " #" .. n
	end
	self.Registry[key] = { Window = win, Section = sec, Name = name, Type = kind, Object = obj, Path = key }
	obj.Path = key
	obj.ElementType = kind
end

function Library:Find(name)
	local direct = self.Registry[name]
	if direct then return direct.Object end
	local best
	for key, entry in pairs(self.Registry) do
		if entry.Name == name and (not best or key < best.Path) then
			best = entry
		end
	end
	return best and best.Object or nil
end

local function readElement(obj)
	if type(obj) ~= "table" or type(obj.Get) ~= "function" then return nil end
	local r = table.pack(pcall(obj.Get, obj))
	if not r[1] then return nil end
	if r.n > 2 then return { table.unpack(r, 2, r.n) } end
	return r[2]
end

function Library:GetValue(name)
	return readElement(self:Find(name))
end

function Library:GetValues()
	local out = {}
	for key, entry in pairs(self.Registry) do
		if entry.Object and entry.Object.Frame and entry.Object.Frame.Parent then
			out[key] = readElement(entry.Object)
		end
	end
	return out
end

