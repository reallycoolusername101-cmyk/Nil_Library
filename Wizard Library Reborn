local function setChartSelected(button, selected)
	if not button or not button.Parent then return end
	local stroke = button:FindFirstChild("SelectedGlow")
	if selected then
		if not stroke then
			stroke = create("UIStroke", {
				Name = "SelectedGlow",
				Color = COLORS.Accent,
				Thickness = 1.5,
				Transparency = 0.25,
			}, button)
		else
			stroke.Color = COLORS.Accent
		end
		tween(stroke, {Transparency = 0.05})
	else
		if stroke then
			tween(stroke, {Transparency = 1})
		end
	end
end

