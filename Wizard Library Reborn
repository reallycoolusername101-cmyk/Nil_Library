		ZIndex = 91,
	}, entry)
	corner(card,9)
	create('UIStroke',{Color=COLORS.Stroke,Thickness=1,Transparency=0.2},card)

	-- slim color accent down the left edge instead of a loud filled badge
	local accent = create('Frame', {
		BackgroundColor3 = config.Color,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0,0),
		Size = UDim2.fromOffset(3,CARD_H),
		ZIndex = 92,
	}, card)

	local badge = create('Frame',{
		BackgroundColor3 = COLORS.Deep,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10,(CARD_H-22)/2),
		Size = UDim2.fromOffset(22,22),
		ZIndex = 93,
	},card)
	corner(badge,11)
	create('UIStroke',{Color=config.Color,Thickness=1,Transparency=0.15},badge)

	local glyphLabel = label(badge, glyph, UDim2.fromOffset(0,0), UDim2.fromOffset(22,22), Enum.Font.SourceSansBold, 13, Enum.TextXAlignment.Center)
	glyphLabel.TextYAlignment = Enum.TextYAlignment.Center
	glyphLabel.TextColor3 = config.Color
	glyphLabel.ZIndex = 94

	local hasText = config.Text ~= ''
	label(card,config.Title,UDim2.fromOffset(42,hasText and 7 or 0),UDim2.fromOffset(CARD_W-52,18),Enum.Font.SourceSansBold,14,Enum.TextXAlignment.Left,true).TextYAlignment = hasText and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
	if hasText then
		local body = label(card,config.Text,UDim2.fromOffset(42,25),UDim2.fromOffset(CARD_W-52,20),Enum.Font.SourceSans,12,Enum.TextXAlignment.Left,true)
		body.TextColor3 = COLORS.SubText
		body.TextYAlignment = Enum.TextYAlignment.Top
	end

	-- thin inset timer bar, recessed into the bottom edge rather than a
	-- heavy bright bar spanning the full width
	local timerTrack = create('Frame',{
		BackgroundColor3 = Color3.fromRGB(0,0,0),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10,CARD_H-4),
		Size = UDim2.fromOffset(CARD_W-20,2),
		ZIndex = 92,
	},card)
	corner(timerTrack,1)

	local timer = create('Frame',{
		BackgroundColor3=config.Color,
		BackgroundTransparency = 0.1,
		BorderSizePixel=0,
		Position=UDim2.fromOffset(0,0),
		Size=UDim2.fromOffset(CARD_W-20,2),
		ZIndex=93,
	},timerTrack)
	corner(timer,1)

	card.Position = UDim2.new(0,CARD_W+20,0,0)
	shadow.Position = UDim2.new(0,CARD_W+23,0,4)
	tween(card,{Position=UDim2.fromOffset(0,0)})
	tween(shadow,{Position=UDim2.fromOffset(3,4)})
	local info = TweenInfo.new(config.Duration,Enum.EasingStyle.Linear,Enum.EasingDirection.Out)
	safeGuiTween(timer,info,{Size=UDim2.fromOffset(0,2)})

	task.delay(config.Duration,function()
		if not entry.Parent then return end
		safeGuiTween(card,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{BackgroundTransparency=1,Position=UDim2.fromOffset(CARD_W+20,0)})
		if shadow.Parent then
			safeGuiTween(shadow,TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{BackgroundTransparency=1,Position=UDim2.fromOffset(CARD_W+23,4)})
		end
		task.delay(0.2,function()
			if entry.Parent then entry:Destroy() end
		end)
	end)

	return self
end

-- custom colour notification: Library:NotifyColor("Title", "Text", Color3, duration, glyph)
function Library:NotifyColor(title, text, color, duration, glyph)
	return self:Notify({Title = title, Text = text, Color = color, Duration = duration, Glyph = glyph or "*", Type = "Custom"})
end
function Library:NotifyError(title, text, duration)
	return self:Notify({Title = title or "Error", Text = text, Type = "Error", Duration = duration or 5})
