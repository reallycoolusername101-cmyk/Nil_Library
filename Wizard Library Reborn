---------------------------------------------------------------------------
local allWindows = {} -- { {Frame=Frame, Window=WindowTable}, ... }
local settingsOpen = false
local globalSettingsWindow = nil
local windowsSection = nil
local listedWindows = {}

-- one show/hide toggle per window (new windows are picked up each time settings opens)
local function refreshWindowToggles()
	if not windowsSection then return end
	for _, w in ipairs(allWindows) do
		if not listedWindows[w.Window] and not (globalSettingsWindow and w.Frame == globalSettingsWindow.Frame) then
			listedWindows[w.Window] = true
			local toggle = windowsSection:CreateToggle(w.Title, function(state)
				if state then w.Window:Show() else w.Window:Hide() end
			end)
			toggle:Set(not w.Window.Hidden)
		end
	end
end

local function H(hex) return Color3.fromHex(hex) end
local function T(w, b, sec, wid, acc, extra)
	local t = { Window = w, Body = b, Section = sec, Widget = wid, Accent = acc }
	if extra then
		for k, v in pairs(extra) do t[k] = v end
		t.Multi = extra.Accent2 ~= nil
	end
	return deriveRoles(t)
end
