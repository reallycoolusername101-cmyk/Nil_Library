                distance = math.round((character.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude)
            end
            ManagePlayerHighlight(player, finalColor, distance)
            ManageBillboardTag(player, finalColor, distance)
        end
    end)
    
    player.CharacterRemoving:Connect(RemoveESP)
end

