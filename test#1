	end
end)

local function FindToolInInventory()
	for i, tool in pairs(LP.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			return tool
		end
	end
	
	for i, tool in pairs(LP.Character:GetChildren()) do
		if tool:IsA("Tool") then
			return tool
		end
	end
	
	return nil
end

local function AutoKill()
	task.spawn(function()
		while _G.AutoKillEnabled do
			pcall(function()
				if LP.Character and LP.Character:FindFirstChild("Humanoid") and LP.Character.Humanoid.Health > 0 then
					local tool = FindToolInInventory()
					
					if tool then
						-- Equip tool
						if tool.Parent == LP.Backpack then
							tool.Parent = LP.Character
							task.wait(0.1)
						end
						
						-- Get target
						local target = nil
						local closestDistance = math.huge
						
						for i, player in pairs(P:GetPlayers()) do
							if player ~= LP and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
								local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
								local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
								
								if targetRoot and myRoot then
									local distance = (targetRoot.Position - myRoot.Position).Magnitude
									if distance < closestDistance then
										closestDistance = distance
										target = player
									end
								end
							end
						end
						
						if target and target.Character then
							local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
							if targetRoot then
								-- Activate tool (attack)
								if tool:FindFirstChild("Handle") then
									local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
									if myRoot then
									--	myRoot.CFrame = targetRoot.CFrame + targetRoot.CFrame.LookVector * 3 (no teleport)
									end
									
									if tool:IsA("Tool") and tool.Parent == LP.Character then
										tool:Activate()
									end
								end
							end
						end
					end
				end
			end)
			task.wait(0.3)
		end
	end)
end

game:GetService('RunService').RenderStepped:Connect(function()
	if _G.AutoKillEnabled then
		AutoKill()
	end
end)
