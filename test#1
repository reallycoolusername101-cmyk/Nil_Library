-- Safely erases ESP elements from a specific character
local function RemoveESP(character)
    if not character then return end
    local highlight = character:FindFirstChild("ESPHighlight")
    if highlight then highlight:Destroy() end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local tag = root and root:FindFirstChild("EspBillboard")
    if tag then tag:Destroy() end
end

-- Clear ESP elements from absolutely everyone (Global reset)
local function WipeAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            RemoveESP(player.Character)
        end
    end
end

-- Creates or updates the overhead Name and Distance UI tags
local function ManageBillboardTag(player, targetColor, distance)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local billboard = root:FindFirstChild("EspBillboard")
    local textLabel
    
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "EspBillboard"
        billboard.Size = UDim2.new(0, 250, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 5, 0) -- FIXED: Set higher (5 studs above head)
        billboard.AlwaysOnTop = true
        
        textLabel = Instance.new("TextLabel")
        textLabel.Name = "EspText"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Font = Enum.Font.RobotoMono
        textLabel.TextSize = 14
        
        -- FIXED: Use high-fidelity UIStroke for crisp text outline rendering
        local uiStroke = Instance.new("UIStroke")
        uiStroke.Name = "TextOutline"
        uiStroke.Color = Color3.fromRGB(255,255,255)
        uiStroke.Thickness = 2
        uiStroke.Transparency = 0
        uiStroke.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize -- Prevent layout distance jitter
        uiStroke.Parent = textLabel
        
        textLabel.Parent = billboard
        billboard.Parent = root
    else
        textLabel = billboard:FindFirstChild("EspText")
    end

    if textLabel then
        textLabel.Text = string.format("%s\n[%d Studs]", player.Name, distance)
        textLabel.TextColor3 = targetColor
        
        -- Max distance limit: Hide completely if 1000+ studs away
        if distance > 1000 then
            billboard.Enabled = false
        else
            billboard.Enabled = _G.NilEspToggle
        end
    end
end

-- Creates or dynamically updates a unique highlight on a character model
local function ManagePlayerHighlight(player, targetColor, distance)
    local character = player.Character
    if not character or player == LP then return end

    local highlight = character:FindFirstChild("ESPHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = character
    end

    if distance > 350 then
        highlight.Enabled = false
    else
        -- ANTI-FLICKER INTERLOCK: Only rewrite if a different team color is registered
        if highlight.OutlineColor ~= targetColor or not highlight.Enabled then
            highlight.FillColor = targetColor
            highlight.FillTransparency = 0.95 -- Force engine to lock custom canvas
            highlight.OutlineTransparency = 0
            highlight.OutlineColor = targetColor
        end
        highlight.Enabled = _G.NilEspToggle
    end
end

-- Scans the folder structure to find a player's current role
local function DeterminePlayerColor(player)
    local playersFolder = workspace:FindFirstChild("Players")
    if not playersFolder then return nil end

    -- 1. Check Killers Folder
    local killers = playersFolder:FindFirstChild("Killers")
    if killers then
        for _, child in ipairs(killers:GetChildren()) do
            if child:GetAttribute("Username") == player.Name or child.Name == player.Name then
                return COLOR_KILLER
            end
        end
    end

    -- 2. Check Spectating Folder
    local spectating = playersFolder:FindFirstChild("Spectating")
    if spectating then
        for _, child in ipairs(spectating:GetChildren()) do
            if child.Name == player.Name then
                return COLOR_DEAD
            end
        end
    end

    -- 3. Check Survivors Folder
    local survivors = playersFolder:FindFirstChild("Survivors")
    if survivors then
        for _, child in ipairs(survivors:GetChildren()) do
            if child.Name == player.Name then
                return COLOR_SURVIVOR
            end
        end
    end

    return nil
end

