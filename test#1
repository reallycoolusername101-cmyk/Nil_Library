-- Function to find the closest generator under 100% progress
local function getClosestIncompleteGenerator(character)
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local closestGen = nil
    local minDistance = math.huge

    for _, gen in ipairs(mapFolder:GetChildren()) do
        if gen.Name ~= "FakeGenerator" then
            local progressObj = gen:FindFirstChild("Progress")
            
            if progressObj and (progressObj:IsA("NumberValue") or progressObj:IsA("IntValue")) then
                local progressValue = progressObj.Value
                
                if progressValue < 100 then
                    local genRoot = gen:FindFirstChild("Main") or gen:FindFirstChild("COLLISION") or gen:FindFirstChildWhichIsA("BasePart")

                    if genRoot then
                        local distance = (rootPart.Position - genRoot.Position).Magnitude
                        if distance < minDistance then
                            minDistance = distance
                            closestGen = gen
                        end
                    end
                end
            end
        end
    end
    return closestGen
end

