            until mapFolder
             

                local closestGenerator = nil
                local closestDistance = math.huge

                for _, child in ipairs(mapFolder:GetDescendants()) do
                    if child:IsA("Model") and child.Name == "Generator" then
                        local part = child:FindFirstChild("Generator") or child:FindFirstChildWhichIsA("BasePart")
                        if part then
